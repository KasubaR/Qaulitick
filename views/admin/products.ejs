<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Management | Admin Panel</title>
    
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- CSRF Token -->
    <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
        <meta name="csrf-token" content="<%= csrfToken %>">
    <% } %>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/icons/Qualitick-01.svg">
    <link rel="apple-touch-icon" href="/images/icons/Qualitick-01.svg">
    
    <!-- Professional Admin Styles -->
    <link rel="stylesheet" href="/css/admin/admin-professional.css">
    <link rel="stylesheet" href="/css/admin/admin-components.css">
    <link rel="stylesheet" href="/css/admin/admin-responsive.css">
    <!-- Admin Dashboard Stylesheet -->
    <link rel="stylesheet" href="/css/admin/dashboard.css">
    <!-- Admin Orders Stylesheet (for action menu styles) -->
    <link rel="stylesheet" href="/css/admin/orders.css">
    <!-- Admin Products Stylesheet -->
    <link rel="stylesheet" href="/css/admin/products.css">
</head>
<body class="admin-page">
    <!-- ADMIN PRODUCTS PAGE -->
    <div class="admin-container">
        <!-- Sidebar Navigation -->
        <%- include('../partials/admin-sidebar', { activePage: 'products' }) %>

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Header -->
            <header class="admin-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="page-title">Product Management</h1>
                </div>
                
                <div class="header-right">
                    <button class="btn-primary" id="addProductBtn">
                        <i class="fas fa-plus"></i> Add Product
                    </button>
                </div>
            </header>

            <!-- Products Content -->
            <div class="products-content">
                <!-- Search and Filters -->
                <div class="products-toolbar">
                    <div class="search-section">
                        <div class="search-box">
                            <i class="fas fa-search"></i>
                            <input type="text" id="productSearch" placeholder="Search products by name, SKU, or brand...">
                            <button class="search-btn" id="searchBtn">Search</button>
                        </div>
                    </div>

                    <div class="filters-section">
                        <div class="filter-group">
                            <label>Category</label>
                            <select id="filterCategory" class="filter-select">
                                <option value="">All Categories</option>
                                <option value="men">Men</option>
                                <option value="women">Women</option>
                                <option value="unisex">Unisex</option>
                                <option value="accessories">Accessories</option>
                                <option value="gift picks">Gift Picks</option>
                            </select>
                        </div>

                        <div class="filter-group">
                            <label>Stock Status</label>
                            <select id="filterStock" class="filter-select">
                                <option value="">All</option>
                                <option value="in-stock">In Stock</option>
                                <option value="low-stock">Low Stock</option>
                                <option value="out-of-stock">Out of Stock</option>
                            </select>
                        </div>

                        <div class="filter-group">
                            <label>Price Range</label>
                            <div class="price-range">
                                <input type="number" id="minPrice" placeholder="Min" class="price-input">
                                <span>-</span>
                                <input type="number" id="maxPrice" placeholder="Max" class="price-input">
                            </div>
                        </div>

                        <div class="filter-group">
                            <label>Sort By</label>
                            <select id="sortBy" class="filter-select">
                                <option value="latest">Latest</option>
                                <option value="price-asc">Price: Low to High</option>
                                <option value="price-desc">Price: High to Low</option>
                                <option value="stock-asc">Stock: Low to High</option>
                                <option value="stock-desc">Stock: High to Low</option>
                                <option value="name-asc">Name: A to Z</option>
                                <option value="name-desc">Name: Z to A</option>
                            </select>
                        </div>

                        <button class="btn-outline" id="clearFiltersBtn">
                            <i class="fas fa-times"></i> Clear Filters
                        </button>
                    </div>
                </div>

                <!-- Products Table -->
                <div class="table-card">
                    <div class="table-header">
                        <div class="table-info">
                            <span id="productsCount">0</span> products found
                        </div>
                        <div class="bulk-actions" id="bulkActions" style="display: none;">
                            <span class="bulk-selection-count" id="bulkSelectionCount">0 selected</span>
                            <button class="btn-outline btn-sm" id="bulkDeleteBtn" title="Delete selected products">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                            <button class="btn-outline btn-sm" id="bulkExportBtn" title="Export selected products">
                                <i class="fas fa-download"></i> Export
                            </button>
                        </div>
                    </div>

                    <div class="table-container">
                        <table class="admin-table" id="productsTable">
                            <thead>
                                <tr>
                                    <th width="50">
                                        <input type="checkbox" id="selectAllCheckbox" title="Select all products">
                                    </th>
                                    <th width="80">Image</th>
                                    <th>Product Name</th>
                                    <th width="100">Category</th>
                                    <th width="100">Price</th>
                                    <th width="80">Discount</th>
                                    <th width="80">Stock</th>
                                    <th width="100">Status</th>
                                    <th width="120">Created</th>
                                    <th width="200">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="productsTableBody">
                                <tr>
                                    <td colspan="11" class="empty-state">
                                        <i class="fas fa-box-open"></i>
                                        <p>No products found</p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="pagination" id="pagination">
                        <button class="page-btn" id="prevPage" disabled>
                            <i class="fas fa-chevron-left"></i> Previous
                        </button>
                        <div class="page-numbers" id="pageNumbers">
                            <span class="page-number active">1</span>
                        </div>
                        <button class="page-btn" id="nextPage">
                            Next <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Add/Edit Product Modal -->
    <div class="modal" id="productModal" style="display: none;">
        <div class="modal-content large">
            <div class="modal-header">
                <h2 id="modalTitle">Add New Product</h2>
                <button class="modal-close" id="closeModal">&times;</button>
            </div>

            <form id="productForm" class="product-form">
                <!-- Tabs -->
                <div class="form-tabs">
                    <button type="button" class="tab-btn active" data-tab="basic">
                        <i class="fas fa-info-circle"></i> Basic Info
                    </button>
                    <button type="button" class="tab-btn" data-tab="media">
                        <i class="fas fa-images"></i> Images & Media
                    </button>
                    <button type="button" class="tab-btn" data-tab="pricing">
                        <i class="fas fa-dollar-sign"></i> Pricing & Inventory
                    </button>
                    <button type="button" class="tab-btn" data-tab="seo">
                        <i class="fas fa-search"></i> SEO Settings
                    </button>
                </div>

                <!-- Tab Content -->
                <div class="tab-content">
                    <!-- Basic Info Tab -->
                    <div class="tab-pane active" id="basicTab">
                        <div class="form-row">
                            <div class="form-group">
                                <label>Model Name <span class="required">*</span></label>
                                <input type="text" id="model" name="model" class="form-input" required>
                            </div>
                            <div class="form-group">
                                <label>Brand <span class="required">*</span></label>
                                <input type="text" id="brand" name="brand" class="form-input" required>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Category <span class="required">*</span></label>
                                <select id="category" name="category" class="form-input" required>
                                    <option value="">Select Category</option>
                                    <option value="men">Men</option>
                                    <option value="women">Women</option>
                                    <option value="unisex">Unisex</option>
                                    <option value="accessories">Accessories</option>
                                    <option value="gift picks">Gift Picks</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>SKU <span class="required">*</span></label>
                                <div class="sku-input-group">
                                    <input type="text" id="sku" name="sku" class="form-input" placeholder="Auto-generated from brand and model">
                                    <button type="button" class="btn-outline small" id="generateSkuBtn" title="Auto-generate SKU">
                                        <i class="fas fa-magic"></i> Generate
                                    </button>
                                </div>
                                <small class="form-hint">SKU will be auto-generated from brand and model, or enter manually</small>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Description <span class="required">*</span></label>
                            <textarea id="description" name="description" class="form-input" rows="5" required></textarea>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Warranty</label>
                                <input type="text" id="warranty" name="warranty" class="form-input" placeholder="e.g., 2 Years">
                            </div>
                            <div class="form-group">
                                <label>Water Resistance</label>
                                <input type="text" id="waterResistance" name="waterResistance" class="form-input" placeholder="e.g., 300m">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Strap Type</label>
                            <input type="text" id="strapType" name="strapType" class="form-input" placeholder="e.g., Metal Bracelet">
                        </div>
                    </div>

                    <!-- Media Tab -->
                    <div class="tab-pane" id="mediaTab">
                        <div class="form-group">
                            <label>Product Images <span class="required">*</span></label>
                            <div class="image-upload-area" id="imageUploadArea">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <p>Click to upload or drag and drop</p>
                                <p class="upload-hint">JPG, PNG, WebP up to 10MB each (Multiple images allowed, recommended: 3-5 images)</p>
                                <p class="upload-hint-small">Recommended: 1200x1200px, under 1MB per image</p>
                                <input type="file" id="productImages" name="images" multiple accept="image/jpeg,image/jpg,image/png,image/webp" style="display: none;">
                            </div>
                            <div class="image-preview-grid" id="imagePreviewGrid">
                                <!-- Image previews will be added here -->
                            </div>
                        </div>

                        <div class="form-group color-options-section">
                            <label class="color-options-label">Color options</label>
                            <p class="form-hint color-options-intro">Add one block per color. For each, type the color name, set stock, and upload a photo of the product in that color—customers see that image when they choose the color.</p>
                            <div id="colorsContainer" class="colors-container" role="list">
                                <!-- Color inputs will be added dynamically -->
                            </div>
                            <button type="button" class="btn-outline small" id="addColorBtn">
                                <i class="fas fa-plus" aria-hidden="true"></i> Add another color
                            </button>
                        </div>

                        <div class="form-group">
                            <label>Product Video (Optional)</label>
                            <input type="url" id="videoUrl" name="videoUrl" class="form-input" placeholder="Video URL (YouTube, Vimeo, etc.)">
                        </div>
                    </div>

                    <!-- Pricing & Inventory Tab -->
                    <div class="tab-pane" id="pricingTab">
                        <div class="form-row">
                            <div class="form-group">
                                <label>Price <span class="required">*</span></label>
                                <input type="number" id="price" name="price" class="form-input" step="0.01" min="0" required>
                            </div>
                            <div class="form-group">
                                <label>Original Price</label>
                                <input type="number" id="originalPrice" name="originalPrice" class="form-input" step="0.01" min="0">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Discount (%)</label>
                                <input type="number" id="discount" name="discount" class="form-input" min="0" max="100" step="0.01">
                            </div>
                            <div class="form-group">
                                <label>Stock Quantity <span class="required">*</span></label>
                                <input type="number" id="stock" name="stock" class="form-input" min="0" step="1" required>
                                <p class="form-hint stock-quantity-hint" id="stockQuantityHint">Total units for this product when you are not using color options.</p>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Low Stock Threshold</label>
                            <input type="number" id="lowStockThreshold" name="lowStockThreshold" class="form-input" min="0" value="5">
                            <small class="form-hint">Alert when stock falls below this number</small>
                        </div>
                    </div>

                    <!-- SEO Tab -->
                    <div class="tab-pane" id="seoTab">

                        <div class="seo-tip-box">
                            <i class="fas fa-lightbulb"></i>
                            <span>Good SEO titles and descriptions help customers find your products on Google. Leave blank to auto-generate from brand &amp; model.</span>
                        </div>

                        <div class="form-group">
                            <label>Meta Title <span class="field-optional">(optional)</span></label>
                            <input type="text" id="metaTitle" name="metaTitle" class="form-input"
                                maxlength="60"
                                placeholder="e.g. Rolex Submariner AAA — Qualitick Collections">
                            <div class="form-hint-row">
                                <small class="form-hint">Include brand, model and 1–2 keywords. Keep it under 60 characters so Google doesn't cut it off.</small>
                                <small class="char-counter" id="metaTitleCounter">0 / 60</small>
                            </div>
                            <small class="form-hint-example"><i class="fas fa-check-circle"></i> Good: <em>Rolex Submariner AAA Luxury Watch — Qualitick</em></small>
                        </div>

                        <div class="form-group">
                            <label>Meta Description <span class="field-optional">(optional)</span></label>
                            <textarea id="metaDescription" name="metaDescription" class="form-input" rows="3"
                                maxlength="160"
                                placeholder="e.g. Shop the Rolex Submariner AAA replica at Qualitick Collections. Premium build, sapphire glass, automatic movement. Fast delivery across Zambia."></textarea>
                            <div class="form-hint-row">
                                <small class="form-hint">Write a natural sentence describing the product. Aim for 140–160 characters. Include key features and a call to action.</small>
                                <small class="char-counter" id="metaDescCounter">0 / 160</small>
                            </div>
                            <small class="form-hint-example"><i class="fas fa-check-circle"></i> Tip: mention movement type, material, warranty, or delivery to stand out in search results.</small>
                        </div>

                        <div class="form-group">
                            <label>URL Slug <span class="field-optional">(optional)</span></label>
                            <div class="slug-input-wrapper">
                                <span class="slug-prefix">/product/</span>
                                <input type="text" id="slug" name="slug" class="form-input slug-field"
                                    placeholder="rolex-submariner-aaa">
                            </div>
                            <div class="form-hint-row">
                                <small class="form-hint">Auto-generated from brand &amp; model if left blank. Use lowercase letters and hyphens only — no spaces or special characters.</small>
                            </div>
                            <small class="form-hint-example"><i class="fas fa-check-circle"></i> Good: <em>rolex-submariner-aaa</em> &nbsp;|&nbsp; <i class="fas fa-times-circle" style="color:#e74c3c"></i> Avoid: <em>Rolex Submariner AAA!</em></small>
                        </div>

                        <div class="form-group">
                            <label class="checkbox-label">
                                <input type="checkbox" id="status" name="status" checked>
                                <span>Active (Product will be visible on site)</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="modal-actions">
                    <button type="button" class="btn-outline" id="cancelBtn">Cancel</button>
                    <button type="button" class="btn-outline" id="prevStepBtn">Previous</button>
                    <button type="button" class="btn-primary" id="nextStepBtn">Next</button>
                    <button type="submit" class="btn-primary" id="saveProductBtn">Save Product</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal" id="deleteModal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Delete Product</h2>
                <button class="modal-close" id="closeDeleteModal">&times;</button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this product? This action cannot be undone.</p>
                <p class="warning-text"><strong>Product:</strong> <span id="deleteProductName"></span></p>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-outline" id="cancelDeleteBtn">Cancel</button>
                <button type="button" class="btn-danger" id="confirmDeleteBtn">
                    <i class="fas fa-trash"></i> Delete Product
                </button>
            </div>
        </div>
    </div>

    <!-- Pass products data to JavaScript -->
    <% if (typeof products !== 'undefined' && products) { %>
    <script>
        // JSON is HTML-encoded to prevent script-injection (stored XSS).
        // The three replacements cover every character that can break out of a
        // script block; JSON.parse on the client reverses the encoding safely.
        window.initialProducts = JSON.parse(<%- JSON.stringify(JSON.stringify(products))
            .replace(/&/g, '\\u0026')
            .replace(/</g, '\\u003c')
            .replace(/>/g, '\\u003e') %>);
    </script>
    <% } %>
    <script>
    // Live character counters for SEO fields
    (function () {
        function bindCounter(inputId, counterId, max) {
            const el = document.getElementById(inputId);
            const counter = document.getElementById(counterId);
            if (!el || !counter) return;
            function update() {
                const len = el.value.length;
                counter.textContent = len + ' / ' + max;
                counter.style.color = len > max * 0.9 ? (len >= max ? '#e74c3c' : '#f39c12') : '#888';
            }
            el.addEventListener('input', update);
            update();
        }
        document.addEventListener('DOMContentLoaded', function () {
            bindCounter('metaTitle', 'metaTitleCounter', 60);
            bindCounter('metaDescription', 'metaDescCounter', 160);
        });
    })();
    </script>
    <script src="/js/admin/auth-utils.js"></script>
    <script src="/js/admin/admin-products.api.js"></script>
    <script src="/js/admin/admin-products.images.js"></script>
    <script src="/js/admin/admin-products.table.js"></script>
    <script src="/js/admin/sidebar.js"></script>
    <script src="/js/admin/orders-badge.js"></script>
    <script src="/js/admin/products.js"></script>
</body>
</html>

