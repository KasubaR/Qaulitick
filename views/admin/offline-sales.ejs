<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/svg+xml" href="/images/icons/Qualitick-01.svg">
    <link rel="apple-touch-icon" href="/images/icons/Qualitick-01.svg">
    <link rel="stylesheet" href="/css/admin/admin.css">
    <link rel="stylesheet" href="/css/admin/offline-sales.css">
</head>
<body class="admin-page">
    <div class="admin-container">
        <%- include('../partials/admin-sidebar', { activePage: 'offline-sales' }) %>

        <main class="admin-main">
            <header class="admin-header">
                <div class="header-left">
                    <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="page-title"><%= viewMode === 'history' ? 'Offline sales history' : 'Add offline sale' %></h1>
                </div>
            </header>

            <p class="offline-sales-intro">
                <%= viewMode === 'history'
                    ? 'Review recently recorded offline sales.'
                    : 'Record in-store or phone sales. Stock is reduced immediately.' %>
            </p>

            <div class="offline-view-switch" role="navigation" aria-label="Offline sales views">
                <a href="/admin/offline-sales/add" class="btn-secondary <%= viewMode === 'add' ? 'is-active' : '' %>">Add offline sale</a>
                <a href="/admin/offline-sales" class="btn-secondary <%= viewMode === 'history' ? 'is-active' : '' %>">View history</a>
            </div>

            <div class="offline-sales-content">
                <% if (viewMode !== 'history') { %>
                <section class="table-card offline-record-card" aria-labelledby="recordSaleHeading">
                    <div class="table-header">
                        <h2 id="recordSaleHeading" class="offline-section-title">Record offline sale</h2>
                    </div>
                    <div class="offline-record-body">
                        <div class="offline-meta-grid">
                            <div class="form-group">
                                <label for="soldAtInput">Sale date &amp; time</label>
                                <input type="datetime-local" id="soldAtInput" class="form-input">
                            </div>
                            <div class="form-group">
                                <label for="customerNameInput">Customer name <span class="label-optional">(optional)</span></label>
                                <input type="text" id="customerNameInput" class="form-input" maxlength="200" autocomplete="name">
                            </div>
                            <div class="form-group">
                                <label for="customerEmailInput">Email <span class="label-optional">(optional)</span></label>
                                <input type="email" id="customerEmailInput" class="form-input" maxlength="255" autocomplete="email">
                            </div>
                            <div class="form-group">
                                <label for="customerPhoneInput">Phone <span class="label-optional">(optional)</span></label>
                                <input type="tel" id="customerPhoneInput" class="form-input" maxlength="50" autocomplete="tel">
                            </div>
                        </div>
                        <div class="form-group offline-notes-group">
                            <label for="notesInput">Notes <span class="label-optional">(optional)</span></label>
                            <textarea id="notesInput" class="form-input" rows="2" maxlength="2000"></textarea>
                        </div>

                        <div class="offline-lines-toolbar">
                            <button type="button" class="btn-secondary" id="addOfflineLineBtn">
                                <i class="fas fa-plus"></i> Add line
                            </button>
                        </div>

                        <div class="table-container offline-lines-wrap">
                            <table class="admin-table offline-lines-table" id="offlineLinesTable">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Color</th>
                                        <th class="th-narrow">Qty</th>
                                        <th class="th-narrow">Unit (ZMW)</th>
                                        <th class="th-narrow">Line total</th>
                                        <th class="th-actions"></th>
                                    </tr>
                                </thead>
                                <tbody id="offlineLineRows"></tbody>
                            </table>
                            <p id="offlineLinesEmpty" class="offline-lines-empty">No lines yet. Click &quot;Add line&quot; to search and select a product.</p>
                        </div>

                        <div class="offline-totals-bar">
                            <div class="offline-total-row">
                                <span>Subtotal</span>
                                <strong id="offlineSubtotalDisplay">K0.00</strong>
                            </div>
                            <div class="offline-total-row offline-total-row--grand">
                                <span>Total</span>
                                <strong id="offlineGrandTotalDisplay">K0.00</strong>
                            </div>
                        </div>

                        <div class="offline-form-actions">
                            <button type="button" class="btn-primary" id="submitOfflineSaleBtn">
                                <i class="fas fa-check"></i> Save sale
                            </button>
                        </div>
                        <div id="offlineFormMessage" class="offline-form-message offline-form-message--hidden" role="status"></div>
                    </div>
                </section>
                <% } %>

                <% if (viewMode === 'history') { %>
                <section class="table-card offline-history-card" aria-labelledby="recentSalesHeading">
                    <div class="table-header">
                        <h2 id="recentSalesHeading" class="offline-section-title">Recent offline sales</h2>
                    </div>
                    <div class="table-container">
                        <table class="admin-table" id="offlineSalesHistoryTable">
                            <thead>
                                <tr>
                                    <th>Sale #</th>
                                    <th>Date</th>
                                    <th>Total</th>
                                    <th>Customer</th>
                                    <th>Recorded by</th>
                                </tr>
                            </thead>
                            <tbody id="offlineSalesHistoryBody">
                                <tr>
                                    <td colspan="5" class="empty-state">Loading…</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <%- include('../partials/admin-pagination', {
                        containerId: 'offlineSalesPagination',
                        prevId: 'offlineSalesPrev',
                        nextId: 'offlineSalesNext',
                        variant: 'simple',
                        pageInfoId: 'offlineSalesPageInfo',
                        pageInfoText: 'Page 1 of 1',
                        hidden: false
                    }) %>
                </section>
                <% } %>
            </div>
        </main>
    </div>

    <div id="offlinePageNotification" class="offline-page-notification" role="alert" aria-live="polite"></div>

    <!-- Add / Edit line modal -->
    <div id="offlineLineModal" class="offline-modal-overlay is-hidden" role="dialog" aria-modal="true" aria-labelledby="offlineLineModalTitle">
        <div class="offline-modal">
            <div class="offline-modal-header">
                <h3 id="offlineLineModalTitle">Add line</h3>
                <button type="button" class="btn-icon offline-modal-close" aria-label="Close"><i class="fas fa-times"></i></button>
            </div>
            <div class="offline-modal-body">
                <div class="form-group">
                    <label for="modalProductSearch">Product</label>
                    <div class="offline-product-search">
                        <input type="text" id="modalProductSearch" class="form-input" placeholder="Search by name, SKU…" autocomplete="off">
                        <div id="modalSearchResults" class="offline-search-results is-hidden" role="listbox"></div>
                    </div>
                    <input type="hidden" id="modalProductId">
                    <p id="modalProductLabel" class="offline-modal-product-label">No product selected</p>
                </div>
                <div class="offline-modal-row">
                    <div class="form-group">
                        <label for="modalColorSelect">Color</label>
                        <select id="modalColorSelect" class="form-select" disabled>
                            <option value="">—</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="modalQty">Qty</label>
                        <input type="number" id="modalQty" class="form-input" min="1" value="1">
                    </div>
                    <div class="form-group">
                        <label for="modalUnitPrice">Unit price (ZMW)</label>
                        <input type="number" id="modalUnitPrice" class="form-input" min="0" step="0.01" value="">
                    </div>
                </div>
                <div class="offline-modal-total">
                    <span>Line total:</span>
                    <strong id="modalLineTotal">K0.00</strong>
                </div>
            </div>
            <div class="offline-modal-footer">
                <button type="button" class="btn-secondary offline-modal-close">Cancel</button>
                <button type="button" class="btn-primary" id="saveLineModalBtn"><i class="fas fa-check"></i> Save line</button>
            </div>
        </div>
    </div>

    <script src="/js/admin/auth-utils.js"></script>
    <script src="/js/admin/sidebar.js"></script>
    <script src="/js/admin/orders-badge.js"></script>
    <script src="/js/admin/offline-sales.js"></script>
</body>
</html>
