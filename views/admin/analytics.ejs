<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analytics Dashboard | Qualitick Collections</title>
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/icons/Qualitick-01.svg">
    <link rel="apple-touch-icon" href="/images/icons/Qualitick-01.svg">
    
    <!-- Professional Admin Styles -->
    <link rel="stylesheet" href="/css/admin/admin.css">
    <link rel="stylesheet" href="/css/admin/analytics.css">
</head>
<body class="admin-page">

    <!-- ADMIN ANALYTICS DASHBOARD -->
    <div class="admin-container">
        <!-- Sidebar Navigation -->
        <%- include('../partials/admin-sidebar', { activePage: 'analytics' }) %>

        <!-- Main Content -->
        <main class="admin-main analytics-page">
            <!-- Header -->
            <header class="admin-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="page-title">Analytics Dashboard</h1>
                </div>
                
                <div class="header-right"></div>
            </header>

            <!-- Google Analytics Link -->
            <section class="analytics-section">
                <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; padding: 60px 20px; text-align:center;">
                    <div style="background:#fff; border-radius:16px; padding:48px; max-width:480px; width:100%; box-shadow:0 2px 16px rgba(0,0,0,0.08);">
                        <img src="https://www.gstatic.com/analytics-suite/header/suite/v2/ic_analytics.svg" alt="Google Analytics" style="width:64px; height:64px; margin-bottom:24px;" onerror="this.style.display='none'">
                        <h2 style="margin:0 0 8px; font-size:1.5rem;">Google Analytics</h2>
                        <p style="color:#666; margin:0 0 32px; line-height:1.6;">View your full traffic reports, real-time users, conversions, and more in Google Analytics.</p>
                        <a href="https://analytics.google.com" target="_blank" rel="noopener noreferrer"
                           style="display:inline-flex; align-items:center; gap:10px; background:#1a73e8; color:#fff; padding:14px 28px; border-radius:8px; text-decoration:none; font-weight:600; font-size:1rem;">
                            <i class="fas fa-chart-line"></i>
                            Open Google Analytics
                            <i class="fas fa-external-link-alt" style="font-size:0.8rem;"></i>
                        </a>
                        <% if (typeof GA4_MEASUREMENT_ID !== 'undefined' && GA4_MEASUREMENT_ID) { %>
                        <p style="margin:24px 0 0; color:#999; font-size:0.85rem;">Tracking ID: <%= GA4_MEASUREMENT_ID %></p>
                        <% } %>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- Sidebar JavaScript -->
    <script src="/js/admin/auth-utils.js"></script>
    <script src="/js/admin/sidebar.js"></script>
    <script src="/js/admin/orders-badge.js"></script>
</body>
</html>

