<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analytics Dashboard | Qualitick Collections</title>
    
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/icons/Qualitick-01.svg">
    <link rel="apple-touch-icon" href="/images/icons/Qualitick-01.svg">
    
    <!-- Professional Admin Styles -->
    <link rel="stylesheet" href="/css/admin/admin-professional.css">
    <link rel="stylesheet" href="/css/admin/admin-components.css">
    <link rel="stylesheet" href="/css/admin/admin-responsive.css">
    <!-- Admin Dashboard Stylesheet (for sidebar consistency) -->
    <link rel="stylesheet" href="/css/admin/dashboard.css">
    <!-- Analytics Dashboard Stylesheet -->
    <link rel="stylesheet" href="/css/admin/analytics.css">
</head>
<body class="admin-page">

    <!-- ADMIN ANALYTICS DASHBOARD -->
    <div class="admin-container">
        <!-- Sidebar Navigation -->
        <%- include('../partials/admin-sidebar', { activePage: 'analytics' }) %>

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Header -->
            <header class="admin-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="page-title">Analytics Dashboard</h1>
                </div>
                
                <div class="header-right">
                    <div class="date-range-selector">
                        <button class="date-btn active" data-range="7">Last 7 Days</button>
                        <button class="date-btn" data-range="30">Last 30 Days</button>
                        <button class="date-btn" data-range="90">Last 90 Days</button>
                        <button class="date-btn" id="customDateBtn">
                            <i class="fas fa-calendar-alt"></i> Custom
                        </button>
                    </div>
                    
                    <div class="header-actions">
                        <button class="icon-btn" id="refreshBtn" title="Refresh Data">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                        <button class="icon-btn" id="exportBtn" title="Export Data">
                            <i class="fas fa-download"></i>
                        </button>
                    </div>
                </div>
            </header>

            <!-- Custom Date Range Modal -->
            <div class="modal-overlay" id="customDateModal" style="display: none;">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3>Select Custom Date Range</h3>
                        <button class="modal-close" id="closeDateModal">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="date-input-group">
                            <label>Start Date</label>
                            <input type="date" id="startDate" class="date-input">
                        </div>
                        <div class="date-input-group">
                            <label>End Date</label>
                            <input type="date" id="endDate" class="date-input">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn-secondary" id="cancelDateBtn">Cancel</button>
                        <button class="btn-primary" id="applyDateBtn">Apply</button>
                    </div>
                </div>
            </div>

            <!-- Loading State -->
            <div class="loading-overlay" id="loadingOverlay" style="display: none;">
                <div class="loading-spinner">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>Loading analytics data...</p>
                </div>
            </div>

            <!-- Error State -->
            <div class="error-banner" id="errorBanner" style="display: none;">
                <i class="fas fa-exclamation-triangle"></i>
                <span id="errorMessage">Failed to load analytics data</span>
                <button class="error-close" id="closeErrorBanner">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Real-time Stats -->
            <section class="analytics-section">
                <div class="section-header">
                    <h2><i class="fas fa-chart-line"></i> Real-time Overview</h2>
                    <div class="real-time-indicator">
                        <span class="pulse-dot"></span>
                        <span>Live</span>
                    </div>
                </div>
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="stat-content">
                            <h3 id="activeUsers">0</h3>
                            <p>Active Users</p>
                            <span class="stat-change positive" id="activeUsersChange">+0%</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                            <i class="fas fa-eye"></i>
                        </div>
                        <div class="stat-content">
                            <h3 id="pageViews">0</h3>
                            <p>Page Views</p>
                            <span class="stat-change positive" id="pageViewsChange">+0%</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                            <i class="fas fa-shopping-cart"></i>
                        </div>
                        <div class="stat-content">
                            <h3 id="sessions">0</h3>
                            <p>Sessions</p>
                            <span class="stat-change positive" id="sessionsChange">+0%</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                            <i class="fas fa-percentage"></i>
                        </div>
                        <div class="stat-content">
                            <h3 id="bounceRate">0%</h3>
                            <p>Bounce Rate</p>
                            <span class="stat-change negative" id="bounceRateChange">-0%</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Charts Section -->
            <section class="analytics-section">
                <div class="section-header">
                    <h2><i class="fas fa-chart-area"></i> Traffic Overview</h2>
                </div>
                <div class="charts-grid">
                    <div class="chart-card">
                        <div class="chart-header">
                            <h3>Users & Sessions Over Time</h3>
                            <div class="chart-legend">
                                <span class="legend-item"><span class="legend-color" style="background: #667eea;"></span> Users</span>
                                <span class="legend-item"><span class="legend-color" style="background: #f5576c;"></span> Sessions</span>
                            </div>
                        </div>
                        <div class="chart-container">
                            <canvas id="trafficChart"></canvas>
                        </div>
                    </div>
                    <div class="chart-card">
                        <div class="chart-header">
                            <h3>Page Views Over Time</h3>
                        </div>
                        <div class="chart-container">
                            <canvas id="pageViewsChart"></canvas>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Top Pages & Traffic Sources -->
            <section class="analytics-section">
                <div class="section-header">
                    <h2><i class="fas fa-list"></i> Top Pages & Traffic Sources</h2>
                </div>
                <div class="data-grid">
                    <div class="data-card">
                        <div class="data-card-header">
                            <h3><i class="fas fa-file-alt"></i> Top Pages</h3>
                        </div>
                        <div class="data-table-container">
                            <table class="data-table" id="topPagesTable">
                                <thead>
                                    <tr>
                                        <th>Page</th>
                                        <th>Views</th>
                                        <th>% of Total</th>
                                    </tr>
                                </thead>
                                <tbody id="topPagesBody">
                                    <tr>
                                        <td colspan="3" class="empty-state">Loading...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="data-card">
                        <div class="data-card-header">
                            <h3><i class="fas fa-globe"></i> Traffic Sources</h3>
                        </div>
                        <div class="chart-container">
                            <canvas id="trafficSourcesChart"></canvas>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Device & Browser Breakdown -->
            <section class="analytics-section">
                <div class="section-header">
                    <h2><i class="fas fa-mobile-alt"></i> Device & Browser Breakdown</h2>
                </div>
                <div class="data-grid">
                    <div class="data-card">
                        <div class="data-card-header">
                            <h3><i class="fas fa-laptop"></i> Devices</h3>
                        </div>
                        <div class="chart-container">
                            <canvas id="devicesChart"></canvas>
                        </div>
                    </div>
                    <div class="data-card">
                        <div class="data-card-header">
                            <h3><i class="fas fa-window-maximize"></i> Browsers</h3>
                        </div>
                        <div class="chart-container">
                            <canvas id="browsersChart"></canvas>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Conversion Events -->
            <section class="analytics-section">
                <div class="section-header">
                    <h2><i class="fas fa-bullseye"></i> Conversion Events</h2>
                </div>
                <div class="conversion-grid">
                    <div class="conversion-card">
                        <div class="conversion-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                            <i class="fas fa-cart-plus"></i>
                        </div>
                        <div class="conversion-content">
                            <h3 id="addToCartCount">0</h3>
                            <p>Add to Cart</p>
                            <span class="conversion-rate" id="addToCartRate">0%</span>
                        </div>
                    </div>
                    <div class="conversion-card">
                        <div class="conversion-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                            <i class="fas fa-shopping-bag"></i>
                        </div>
                        <div class="conversion-content">
                            <h3 id="checkoutStartedCount">0</h3>
                            <p>Checkout Started</p>
                            <span class="conversion-rate" id="checkoutStartedRate">0%</span>
                        </div>
                    </div>
                    <div class="conversion-card">
                        <div class="conversion-icon" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="conversion-content">
                            <h3 id="purchasesCount">0</h3>
                            <p>Purchases</p>
                            <span class="conversion-rate" id="purchasesRate">0%</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- GA4 Integration Notice -->
            <% if (!GA4_MEASUREMENT_ID) { %>
            <div class="info-banner">
                <i class="fas fa-info-circle"></i>
                <div>
                    <strong>Google Analytics Not Configured</strong>
                    <p>To view real analytics data, configure GA4_MEASUREMENT_ID in your .env file and set up Google Analytics API credentials.</p>
                    <a href="https://developers.google.com/analytics/devguides/reporting/data/v1" target="_blank" rel="noopener noreferrer" class="info-link">
                        Learn more about GA4 Reporting API <i class="fas fa-external-link-alt"></i>
                    </a>
                </div>
            </div>
            <% } %>
        </main>
    </div>

    <!-- Chart.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <!-- Sidebar JavaScript -->
    <script src="/js/admin/auth-utils.js"></script>
    <script src="/js/admin/sidebar.js"></script>
    <script src="/js/admin/orders-badge.js"></script>
    <!-- Analytics Dashboard JavaScript -->
    <script src="/js/admin/analytics.js"></script>
</body>
</html>

