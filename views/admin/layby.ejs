<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Layby plans | Admin Panel</title>
    <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
        <meta name="csrf-token" content="<%= csrfToken %>">
    <% } %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/svg+xml" href="/images/icons/Qualitick-01.svg">
    <link rel="apple-touch-icon" href="/images/icons/Qualitick-01.svg">
    <link rel="stylesheet" href="/css/admin/admin.css">
    <link rel="stylesheet" href="/css/admin/layby.css">
</head>
<body class="admin-page">
    <div class="admin-container">
        <%- include('../partials/admin-sidebar', { activePage: 'layby' }) %>

        <main class="admin-main">
            <header class="admin-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="Toggle sidebar">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="page-title">Layby plans</h1>
                </div>
                <div class="header-right">
                    <%- include('../partials/admin-button', { id: 'refreshBtn', icon: 'fa-sync-alt', label: 'Refresh', buttonType: 'button' }) %>
                </div>
            </header>

            <noscript>
                <p class="admin-noscript-notice">JavaScript is required to use the admin panel.</p>
            </noscript>

            <div class="orders-content">
                <div class="admin-toolbar">
                    <%- include('../partials/admin-search-box', {
                        inputId: 'laybySearch',
                        placeholder: 'Search by order number…',
                        autocomplete: 'off',
                        buttonType: 'button'
                    }) %>
                    <div class="filters-section">
                        <div class="filter-group">
                            <label for="filterPlanStatus">Plan status</label>
                            <select id="filterPlanStatus" class="filter-select">
                                <option value="">All</option>
                                <option value="active">Active</option>
                                <option value="completed">Completed</option>
                                <option value="cancelled">Cancelled</option>
                            </select>
                        </div>
                        <%- include('../partials/admin-button', { id: 'clearFiltersBtn', icon: 'fa-times', label: 'Clear', buttonType: 'button' }) %>
                    </div>
                </div>

                <div class="table-card">
                    <div class="table-header">
                        <div class="table-info">
                            <span id="laybyCount">0</span> plans
                        </div>
                    </div>
                    <div class="table-container">
                        <table class="admin-table" id="laybyTable">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Order</th>
                                    <th>Customer</th>
                                    <th>Status</th>
                                    <th>Paid</th>
                                    <th>Balance</th>
                                    <th>Next action</th>
                                    <th>Next due</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="laybyBody">
                                <tr>
                                    <td colspan="9" class="empty-state">Loading…</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination -->
                    <%- include('../partials/admin-pagination', { containerId: 'pagination', prevId: 'prevPage', nextId: 'nextPage' }) %>
                </div>
            </div>
        </main>
    </div>

    <script src="/js/admin/auth-utils.js"></script>
    <script src="/js/admin/sidebar.js"></script>
    <script src="/js/admin/orders-badge.js"></script>
    <script src="/js/admin/admin-layby.api.js"></script>
    <script src="/js/admin/layby-list.js"></script>
</body>
</html>
