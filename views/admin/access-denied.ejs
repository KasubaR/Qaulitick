<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Access Denied | Admin Panel' %></title>
    
    <!-- Font: Satoshi (local) -->
    <link rel="stylesheet" href="/fonts/WEB/css/satoshi.css">
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/icons/Qualitick-01.svg">
    <link rel="apple-touch-icon" href="/images/icons/Qualitick-01.svg">
    
    <!-- Access Denied Styles -->
    <link rel="stylesheet" href="/css/admin/login.css">
    <style>
        .access-denied-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: var(--login-bg-primary);
        }

        .access-denied-card {
            background: #fff;
            border: 1px solid var(--login-border);
            border-radius: 16px;
            padding: 40px 36px;
            max-width: 480px;
            width: 100%;
            text-align: center;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.07);
        }

        .access-denied-icon {
            font-size: 48px;
            color: var(--login-error);
            margin-bottom: 20px;
        }

        .access-denied-title {
            font-size: 24px;
            font-weight: 700;
            color: var(--login-text-primary);
            margin-bottom: 10px;
        }

        .access-denied-message {
            font-size: 14px;
            color: var(--login-text-secondary);
            margin-bottom: 24px;
            line-height: 1.6;
        }

        .access-denied-error {
            background: rgba(185, 28, 28, 0.06);
            border: 1px solid rgba(185, 28, 28, 0.2);
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 24px;
            color: var(--login-error);
            font-size: 13px;
            text-align: left;
        }

        .access-denied-actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
            align-items: center;
        }

        .btn-primary-access {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 24px;
            background: linear-gradient(to right, var(--login-gold), var(--login-gold-light));
            color: #000;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            transition: box-shadow 0.2s, transform 0.2s;
        }

        .btn-primary-access:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(175, 144, 68, 0.3);
        }

        .btn-secondary-access {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 22px;
            background: transparent;
            color: var(--login-text-secondary);
            text-decoration: none;
            border: 1px solid var(--login-border);
            border-radius: 8px;
            font-size: 13px;
            transition: color 0.2s, border-color 0.2s;
        }

        .btn-secondary-access:hover {
            color: var(--login-gold);
            border-color: var(--login-gold);
        }

        .info-box {
            background: #f9f9f9;
            border: 1px solid var(--login-border);
            border-radius: 8px;
            padding: 14px 16px;
            margin-top: 24px;
            color: var(--login-text-secondary);
            font-size: 12px;
            line-height: 1.6;
            text-align: left;
        }

        .info-box strong {
            color: var(--login-text-primary);
        }

        @media (max-width: 480px) {
            .access-denied-card {
                padding: 32px 20px;
            }
        }
    </style>
</head>
<body class="login-page">
    <div class="access-denied-container">
        <div class="access-denied-card">
            <!-- Icon -->
            <div class="access-denied-icon">
                <i class="fas fa-shield-alt"></i>
            </div>
            
            <!-- Title -->
            <h1 class="access-denied-title">Access Denied</h1>
            
            <!-- Message -->
            <p class="access-denied-message">
                You need to be authenticated to access this page. Please log in with your admin credentials.
            </p>
            
            <!-- Error Message (if provided) -->
            <% if (typeof error !== 'undefined' && error) { %>
            <div class="access-denied-error">
                <i class="fas fa-exclamation-circle"></i>
                <!-- SECURITY: always use escaped output here — error may contain user-influenced content. -->
                <strong>Error:</strong> <%= error %>
            </div>
            <% } %>
            
            <!-- Actions -->
            <div class="access-denied-actions">
                <% if (typeof showLoginLink !== 'undefined' && showLoginLink !== false) { %>
                <a href="/admin/login" class="btn-primary-access">
                    <i class="fas fa-sign-in-alt"></i>
                    <span>Go to Login Page</span>
                </a>
                <% } %>
                
                <a href="/" class="btn-secondary-access">
                    <i class="fas fa-home"></i>
                    <span>Back to Home</span>
                </a>
            </div>
            
            <!-- Info Box -->
            <div class="info-box">
                <i class="fas fa-info-circle"></i>
                <strong>Note:</strong> To access the admin panel, you need to use the secret URL with your admin credentials. 
                Contact your administrator if you need access.
            </div>
        </div>
        
    </div>
</body>
</html>

