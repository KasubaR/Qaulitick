<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Layby plan | Admin Panel</title>
    <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
        <meta name="csrf-token" content="<%= csrfToken %>">
    <% } %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/svg+xml" href="/images/icons/Qualitick-01.svg">
    <link rel="apple-touch-icon" href="/images/icons/Qualitick-01.svg">
    <link rel="stylesheet" href="/css/admin/admin.css">
    <link rel="stylesheet" href="/css/admin/layby.css">
</head>
<body class="admin-page">
    <div class="admin-container">
        <%- include('../partials/admin-sidebar', { activePage: 'layby' }) %>
        <% const _laybyDetailPlanIdParsed = typeof planId !== 'undefined' && planId !== null && planId !== ''
            ? parseInt(planId, 10)
            : NaN;
           const _laybyDetailPlanIdOk = Number.isFinite(_laybyDetailPlanIdParsed);
           const _laybyDetailPlanIdAttr = _laybyDetailPlanIdOk ? JSON.stringify(_laybyDetailPlanIdParsed) : ''; %>

        <main class="admin-main" id="laybyDetailMain" data-plan-id="<%- _laybyDetailPlanIdAttr %>">
            <header class="admin-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="Toggle sidebar">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="page-title">Layby plan #<span id="detailPlanIdLabel"><%= _laybyDetailPlanIdOk ? _laybyDetailPlanIdParsed : '' %></span></h1>
                </div>
                <div class="header-right">
                    <a class="btn-outline" href="/admin/layby"><i class="fas fa-arrow-left"></i> All plans</a>
                    <%- include('../partials/admin-button', { id: 'refreshDetailBtn', icon: 'fa-sync-alt', label: 'Refresh', buttonType: 'button' }) %>
                </div>
            </header>

            <noscript>
                <p class="admin-noscript-notice">JavaScript is required to use the admin panel.</p>
            </noscript>

            <div id="laybyDetailError" class="layby-detail-alert layby-detail-alert--error layby-detail-alert--hidden" role="alert"></div>

            <div id="laybyDetailContent" class="layby-detail-content layby-detail-content--hidden">
                <section class="table-card layby-detail-summary">
                    <div class="card-header">
                        <h3>Plan summary</h3>
                    </div>
                    <div class="layby-detail-summary-body">
                        <dl class="layby-detail-dl">
                            <dt>Order</dt>
                            <dd id="summaryOrderNumber">—</dd>
                            <dt>Checkout</dt>
                            <dd id="summaryCheckout">—</dd>
                            <dt>Customer</dt>
                            <dd id="summaryCustomer">—</dd>
                            <dt>Plan status</dt>
                            <dd id="summaryPlanStatus">—</dd>
                            <dt>Payment arrangement</dt>
                            <dd id="summaryArrangement">—</dd>
                            <dt>Balance</dt>
                            <dd id="summaryBalance" class="layby-detail-dd--money">—</dd>
                            <dt>Total</dt>
                            <dd id="summaryTotal" class="layby-detail-dd--money">—</dd>
                            <dt>Amount paid</dt>
                            <dd id="summaryAmountPaid" class="layby-detail-dd--money">—</dd>
                            <dt>Next action</dt>
                            <dd id="summaryNextAction">—</dd>
                            <dt>Next due</dt>
                            <dd id="summaryNextDue">—</dd>
                        </dl>

                        <div id="summaryOrderSummary" class="layby-order-summary layby-order-summary--hidden" aria-label="Order line items and totals"></div>

                        <div class="layby-detail-status-row">
                            <label for="planStatusSelect">Update plan status</label>
                            <select id="planStatusSelect" class="filter-select">
                                <option value="active">active</option>
                                <option value="completed">completed</option>
                                <option value="cancelled">cancelled</option>
                            </select>
                            <button type="button" class="btn-primary" id="savePlanStatusBtn">Save status</button>
                        </div>
                        <p class="layby-detail-hint">Completed requires zero balance. Cancellation restores reserved stock and cannot be reversed here.</p>
                    </div>
                </section>

                <section class="table-card layby-installments-section">
                    <div class="card-header">
                        <h3>Installments</h3>
                    </div>
                    <div class="table-container">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Scheduled amount</th>
                                    <th>Due date</th>
                                    <th>Installment status</th>
                                    <th>Admin confirmed</th>
                                    <th>Payment source</th>
                                    <th>Provider status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="installmentsBody"></tbody>
                        </table>
                    </div>
                </section>
            </div>
        </main>
    </div>

    <!-- Inline confirmation modal for irreversible actions -->
    <div id="confirmModal" role="dialog" aria-modal="true" aria-labelledby="confirmModalTitle"
         style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.5);align-items:center;justify-content:center;">
        <div style="background:#fff;border-radius:8px;padding:2rem;max-width:420px;width:90%;box-shadow:0 4px 24px rgba(0,0,0,.2);">
            <h3 id="confirmModalTitle" style="margin:0 0 .75rem;font-size:1.1rem;">Confirm action</h3>
            <p id="confirmModalBody" style="margin:0 0 1.5rem;color:#444;"></p>
            <div style="display:flex;gap:.75rem;justify-content:flex-end;">
                <button type="button" id="confirmModalCancel" class="btn-outline">Cancel</button>
                <button type="button" id="confirmModalOk" class="btn-primary" style="background:#c0392b;border-color:#c0392b;">Confirm</button>
            </div>
        </div>
    </div>

    <script src="/js/admin/auth-utils.js"></script>
    <script src="/js/admin/sidebar.js"></script>
    <script src="/js/admin/orders-badge.js"></script>
    <script src="/js/admin/admin-layby.api.js"></script>
    <script src="/js/admin/layby-detail.js"></script>
</body>
</html>
