<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory Management | Admin Panel</title>
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/icons/Qualitick-01.svg">
    <link rel="apple-touch-icon" href="/images/icons/Qualitick-01.svg">
    
    <!-- Professional Admin Styles -->
    <link rel="stylesheet" href="/css/admin/admin.css">
    <link rel="stylesheet" href="/css/admin/inventory.css">
</head>
<body class="admin-page">
    <!-- ADMIN INVENTORY PAGE -->
    <div class="admin-container">
        <!-- Sidebar Navigation -->
        <%- include('../partials/admin-sidebar', { activePage: 'inventory' }) %>

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Header -->
            <header class="admin-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="page-title">Inventory Management</h1>
                </div>
                
                <div class="header-right">
                    <%- include('../partials/admin-button', { id: 'exportInventoryBtn', icon: 'fa-download', label: 'Export' }) %>
                </div>
            </header>

            <!-- Inventory Content -->
            <div class="inventory-content">
                <!-- Statistics Cards -->
                <div class="kpi-grid">
                    <%- include('../partials/admin-stat-card', { label: 'Total Products',        iconVariant: 'inventory',    valueId: 'totalProducts',   value: '0' }) %>
                    <%- include('../partials/admin-stat-card', { label: 'In Stock',              iconVariant: 'verified',     valueId: 'inStockCount',    value: '0' }) %>
                    <%- include('../partials/admin-stat-card', { label: 'Low Stock',             iconVariant: 'alerts',       valueId: 'lowStockCount',   value: '0' }) %>
                    <%- include('../partials/admin-stat-card', { label: 'Out of Stock',          iconVariant: 'out-of-stock', valueId: 'outOfStockCount', value: '0' }) %>
                    <%- include('../partials/admin-stat-card', { label: 'Total Inventory Value', iconVariant: 'sales',        valueId: 'totalValue',      value: 'K0' }) %>
                </div>

                <!-- Search and Filters -->
                <div class="orders-toolbar">
                    <%- include('../partials/admin-search-box', {
                        inputId: 'inventorySearch',
                        placeholder: 'Search by product name, SKU, or brand...'
                    }) %>

                    <div class="filters-section">
                        <div class="filter-group">
                            <label>Stock Status</label>
                            <select id="filterStockStatus" class="filter-select">
                                <option value="">All Status</option>
                                <option value="in-stock">In Stock</option>
                                <option value="low-stock">Low Stock</option>
                                <option value="out-of-stock">Out of Stock</option>
                            </select>
                        </div>

                        <div class="filter-group">
                            <label>Category</label>
                            <select id="filterCategory" class="filter-select">
                                <option value="">All Categories</option>
                                <option value="Men">Men</option>
                                <option value="Women">Women</option>
                                <option value="Unisex">Unisex</option>
                                <option value="Accessories">Accessories</option>
                                <option value="Gift Picks">Gift Picks</option>
                            </select>
                        </div>

                        <div class="filter-group">
                            <label>Brand</label>
                            <select id="filterBrand" class="filter-select">
                                <option value="">All Brands</option>
                                <!-- Brands will be populated dynamically -->
                            </select>
                        </div>

                        <div class="filter-group">
                            <label>Sort By</label>
                            <select id="sortBy" class="filter-select">
                                <option value="stock-asc">Stock: Low to High</option>
                                <option value="stock-desc">Stock: High to Low</option>
                                <option value="name-asc">Name: A to Z</option>
                                <option value="name-desc">Name: Z to A</option>
                                <option value="value-asc">Value: Low to High</option>
                                <option value="value-desc">Value: High to Low</option>
                            </select>
                        </div>

                        <%- include('../partials/admin-button', { id: 'clearFiltersBtn', icon: 'fa-times', label: 'Clear Filters' }) %>
                    </div>
                </div>

                <!-- Inventory Table -->
                <div class="table-card">
                    <div class="table-header">
                        <div class="table-info">
                            <span id="inventoryCount">0</span> products found
                        </div>
                    </div>

                    <div class="table-container">
                        <table class="admin-table" id="inventoryTable">
                            <thead>
                                <tr>
                                    <th width="80">Image</th>
                                    <th>Product</th>
                                    <th width="100">SKU</th>
                                    <th width="120">Brand</th>
                                    <th width="100">Current Stock</th>
                                    <th width="100">Low Stock Threshold</th>
                                    <th width="120">Stock Status</th>
                                    <th width="120">Unit Price</th>
                                    <th width="120">Total Value</th>
                                    <th width="250">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="inventoryTableBody">
                                <tr>
                                    <td colspan="10" class="empty-state">
                                        <i class="fas fa-warehouse"></i>
                                        <p>No products found</p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <%- include('../partials/admin-pagination', { containerId: 'pagination', prevId: 'prevPage', nextId: 'nextPage' }) %>
                </div>
            </div>
        </main>
    </div>

    <!-- Update Stock Modal -->
    <div class="modal" id="updateStockModal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Update Stock - <span id="updateStockProductName"></span></h2>
                <button class="modal-close" id="closeUpdateStockModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Current Stock</label>
                    <input type="number" id="currentStock" class="form-input" readonly>
                </div>
                <div class="form-group">
                    <label>Adjustment Type</label>
                    <select id="adjustmentType" class="form-input">
                        <option value="set">Set to Specific Value</option>
                        <option value="add">Add Quantity</option>
                        <option value="subtract">Subtract Quantity</option>
                    </select>
                </div>
                <div class="form-group">
                    <label id="adjustmentLabel">New Stock Quantity</label>
                    <input type="number" id="stockAdjustment" class="form-input" min="0" placeholder="Enter quantity">
                </div>
                <div class="form-group">
                    <label>Reason (Optional)</label>
                    <textarea id="stockAdjustmentReason" class="form-input" rows="3" placeholder="Reason for stock adjustment..."></textarea>
                </div>
                <div class="stock-preview">
                    <div class="preview-item">
                        <span>Current Stock:</span>
                        <span id="previewCurrent">0</span>
                    </div>
                    <div class="preview-item">
                        <span>Adjustment:</span>
                        <span id="previewAdjustment">0</span>
                    </div>
                    <div class="preview-item total">
                        <span>New Stock:</span>
                        <span id="previewNew">0</span>
                    </div>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn-outline" id="cancelUpdateStockBtn">Cancel</button>
                <button class="btn-primary" id="confirmUpdateStockBtn">Update Stock</button>
            </div>
        </div>
    </div>

    <script src="/js/admin/auth-utils.js"></script>
    <script src="/js/admin/sidebar.js"></script>
    <script src="/js/admin/orders-badge.js"></script>
    <script src="/js/admin/admin-inventory.api.js"></script>
    <script src="/js/admin/inventory.js"></script>
</body>
</html>

