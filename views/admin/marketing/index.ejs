<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Marketing Management | Admin Panel</title>
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/icons/Qualitick-01.svg">
    <link rel="apple-touch-icon" href="/images/icons/Qualitick-01.svg">
    
<!-- Professional Admin Styles -->
    <link rel="stylesheet" href="/css/admin/admin.css">
<!-- Admin Dashboard Stylesheet -->
</head>
<body class="admin-page">

    <div class="admin-container">
        <!-- Sidebar Navigation -->
        <%- include('../../partials/admin-sidebar', { activePage: 'marketing' }) %>

        <main class="admin-main">
            <div class="admin-header">
                <div>
                    <h1><i class="fas fa-bullhorn"></i> Marketing Management</h1>
                    <p>Manage flash sales and featured products</p>
                </div>
            </div>

            <div class="dashboard-content">
                <div class="marketing-grid">
                <a href="/admin/marketing/flash-sales" class="marketing-card">
                    <div class="marketing-card-icon">
                        <i class="fas fa-bolt"></i>
                    </div>
                    <h3>Flash Sales</h3>
                    <p>Create urgency-driven time-limited sales with countdown timers, limited stock alerts, and automatic scheduling.</p>
                    <span class="btn-link">Manage Flash Sales →</span>
                </a>

                <a href="/admin/marketing/featured-products" class="marketing-card">
                    <div class="marketing-card-icon">
                        <i class="fas fa-star"></i>
                    </div>
                    <h3>Featured Products</h3>
                    <p>Select and manage products displayed in the featured collection section on the home page.</p>
                    <span class="btn-link">Manage Featured Products →</span>
                </a>
                </div>

                <div class="kpi-grid" style="margin-top: 24px;">
                    <%- include('../../partials/admin-stat-card', { label: 'Active Flash Sales',  iconVariant: 'flash',    valueId: 'activeFlashSales',     value: '0' }) %>
                    <%- include('../../partials/admin-stat-card', { label: 'Featured Products',   iconVariant: 'featured', valueId: 'featuredProductsCount', value: '0' }) %>
                </div>
            </div>
        </main>
    </div>

    <script src="/js/admin/auth-utils.js"></script>
    <script src="/js/admin/sidebar.js"></script>
    <script src="/js/admin/orders-badge.js"></script>
    <script>
        // TODO: Load stats from API
        // document.getElementById('activeFlashSales').textContent = flashSalesCount;
        // document.getElementById('featuredProductsCount').textContent = featuredCount;
        // document.getElementById('activeOffers').textContent = offersCount;
    </script>

</body>
</html>

