<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Featured Products Management | Admin Panel</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="icon" type="image/svg+xml" href="/images/icons/Qualitick-01.svg">
    <link rel="apple-touch-icon" href="/images/icons/Qualitick-01.svg">

    <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
        <meta name="csrf-token" content="<%= csrfToken %>">
    <% } %>

    <link rel="stylesheet" href="/css/admin/admin.css">
    <style>
        /* ── Featured product grid ───────────────────────────── */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 16px;
            margin-top: 16px;
            min-height: 200px;
            opacity: 0;
            transition: opacity 0.3s ease-in;
        }

        .product-grid.loaded { opacity: 1; }

        .product-grid:empty::before {
            content: '';
            display: block;
            width: 36px;
            height: 36px;
            border: 3px solid var(--border);
            border-top-color: var(--gold);
            border-radius: 50%;
            margin: 60px auto;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin { to { transform: rotate(360deg); } }

        /* ── Individual card ─────────────────────────────────── */
        .featured-product-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 12px;
            text-align: center;
            position: relative;
            cursor: move;
            transition: border-color var(--transition), box-shadow var(--transition);
        }

        .featured-product-card:hover {
            border-color: var(--gold);
            box-shadow: var(--shadow);
        }

        .featured-product-card img {
            width: 100%;
            height: 140px;
            object-fit: cover;
            border-radius: var(--radius-sm);
            margin-bottom: 10px;
            background: var(--surface-2);
        }

        .featured-product-card .product-title {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 4px;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .featured-product-card .product-price {
            font-size: 0.78rem;
            color: var(--text-muted);
        }

        /* remove button */
        .featured-product-card .remove-btn {
            position: absolute;
            top: 6px;
            right: 6px;
            background: var(--danger);
            color: #fff;
            border: none;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            transition: opacity var(--transition);
        }

        .featured-product-card:hover .remove-btn { opacity: 1; }

        /* order badge */
        .featured-product-card .order-number {
            position: absolute;
            top: 6px;
            left: 6px;
            background: var(--gold);
            color: #fff;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.72rem;
            font-weight: 700;
        }

        /* product status badges */
        .product-badge {
            position: absolute;
            top: 34px;
            left: 6px;
            padding: 2px 7px;
            border-radius: var(--radius-sm);
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            z-index: 10;
        }

        .badge-warning     { background: var(--warn-soft);   color: var(--warn); }
        .badge-deleted     { background: var(--danger-soft); color: var(--danger); }
        .badge-out-of-stock { background: var(--surface-3);  color: var(--text-muted); }

        /* invalid / disabled states */
        .featured-product-card.invalid         { border-color: var(--danger-border); }
        .featured-product-card.invalid.deleted { background: var(--danger-soft); }
        .featured-product-card.invalid.inactive { border-color: var(--warn-border); background: var(--warn-soft); }
        .featured-product-card.invalid.out-of-stock { border-color: var(--border); background: var(--surface-3); }

        .featured-product-card.disabled {
            opacity: 0.55;
            pointer-events: none;
        }

        /* ── Section search row ──────────────────────────────── */
        .fp-search-row {
            margin-bottom: 16px;
        }
    </style>
</head>
<body class="admin-page">

<div class="admin-container">
    <%- include('../../partials/admin-sidebar', { activePage: 'marketing', activeSubPage: 'featured-products' }) %>

    <main class="admin-main">

        <header class="admin-header">
            <div class="header-left">
                <button class="sidebar-toggle" id="sidebarToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <h1 class="page-title">Featured Products</h1>
            </div>
            <div class="header-right">
                <%- include('../../partials/admin-button', { id: 'cleanupDeletedBtn', icon: 'fa-broom', label: 'Cleanup Deleted', title: 'Remove featured products that reference deleted products' }) %>
                <%- include('../../partials/admin-button', { id: 'cleanupInactiveBtn', icon: 'fa-exclamation-triangle', label: 'Cleanup Inactive', title: 'Remove inactive or out-of-stock featured products' }) %>
                <%- include('../../partials/admin-button', { variant: 'primary', id: 'addProductBtn', icon: 'fa-plus', label: 'Add Product' }) %>
            </div>
        </header>

        <div class="dashboard-content">

            <!-- Featured slots -->
            <div class="admin-card">
                <div class="card-header">
                    <h3>Featured Products <span class="text-muted" style="font-weight:400;">(displayed on home page)</span></h3>
                    <p>Drag and drop to reorder. Maximum <strong id="maxFeaturedCount">4</strong> products displayed.</p>
                </div>
                <div id="featuredProductsGrid" class="product-grid"></div>
            </div>

            <!-- Available products -->
            <div class="admin-card" style="margin-top: 20px;">
                <div class="card-header">
                    <h3>Available Products</h3>
                </div>
                <div class="fp-search-row">
                    <input type="text" id="productSearch" class="form-input" placeholder="Search products…" style="max-width: 320px;">
                </div>
                <div id="availableProductsGrid" class="product-grid"></div>
            </div>

        </div>
    </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
<script src="/js/admin/auth-utils.js"></script>
<script src="/js/admin/sidebar.js"></script>
<script src="/js/admin/orders-badge.js"></script>
<script src="/js/admin/featured-products.js?v=2"></script>

</body>
</html>
