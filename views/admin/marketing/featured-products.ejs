<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Featured Products Management | Admin Panel</title>
    
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/icons/Qualitick-01.svg">
    <link rel="apple-touch-icon" href="/images/icons/Qualitick-01.svg">

    <!-- CSRF Token -->
    <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
        <meta name="csrf-token" content="<%= csrfToken %>">
    <% } %>
    
    <!-- Professional Admin Styles -->
    <link rel="stylesheet" href="/css/admin/admin-professional.css">
    <link rel="stylesheet" href="/css/admin/admin-components.css">
    <link rel="stylesheet" href="/css/admin/admin-responsive.css">
    <!-- Admin Dashboard Stylesheet -->
    <link rel="stylesheet" href="/css/admin/dashboard.css">
    <style>
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        .featured-product-card {
            background: #1a1a1a;
            border: 2px solid rgba(255, 215, 0, 0.2);
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            position: relative;
            cursor: move;
        }
        .featured-product-card img {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-radius: 5px;
            margin-bottom: 10px;
        }
        .featured-product-card .remove-btn {
            position: absolute;
            top: 5px;
            right: 5px;
            background: #ff4444;
            color: white;
            border: none;
            border-radius: 50%;
            width: 25px;
            height: 25px;
            cursor: pointer;
        }
        .featured-product-card .order-number {
            position: absolute;
            top: 5px;
            left: 5px;
            background: rgba(255, 215, 0, 0.9);
            color: #000;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }
        .featured-product-card.featured {
            border-color: rgba(255, 215, 0, 0.5);
        }
        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 40px;
        }
        .empty-state i {
            font-size: 48px;
            color: #666;
            margin-bottom: 20px;
        }
        .product-grid {
            min-height: 200px;
            opacity: 0;
            transition: opacity 0.3s ease-in;
        }
        .product-grid.loaded {
            opacity: 1;
        }
        .product-grid:empty::before {
            content: '';
            display: block;
            width: 40px;
            height: 40px;
            border: 4px solid rgba(255, 215, 0, 0.2);
            border-top-color: #FFD700;
            border-radius: 50%;
            margin: 60px auto;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        .product-badge {
            position: absolute;
            top: 35px;
            left: 5px;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: bold;
            z-index: 10;
            text-transform: uppercase;
        }
        .badge-warning {
            background: #ff9800;
            color: #000;
        }
        .badge-deleted {
            background: #ff4444;
            color: #fff;
        }
        .badge-out-of-stock {
            background: #9e9e9e;
            color: #fff;
        }
        .featured-product-card.disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .featured-product-card.disabled button {
            cursor: not-allowed;
            opacity: 0.5;
        }
        .featured-product-card.invalid {
            border-color: rgba(255, 68, 68, 0.5);
        }
        .featured-product-card.invalid.deleted {
            border-color: rgba(255, 68, 68, 0.8);
            background: rgba(255, 68, 68, 0.1);
        }
        .featured-product-card.invalid.inactive {
            border-color: rgba(255, 152, 0, 0.8);
            background: rgba(255, 152, 0, 0.1);
        }
        .featured-product-card.invalid.out-of-stock {
            border-color: rgba(158, 158, 158, 0.8);
            background: rgba(158, 158, 158, 0.1);
        }
        .featured-product-card.disabled {
            pointer-events: none;
        }
        .featured-product-card.disabled button {
            pointer-events: none;
        }
    </style>
</head>
<body class="admin-page">

    <div class="admin-container">
        <!-- Sidebar Navigation -->
        <%- include('../../partials/admin-sidebar', { activePage: 'marketing', activeSubPage: 'featured-products' }) %>

        <main class="admin-main">
            <div class="admin-header">
                <h1><i class="fas fa-star"></i> Featured Products Management</h1>
                <div style="display: flex; gap: 10px;">
                    <button class="btn-secondary" onclick="cleanupDeletedProducts()" title="Remove featured products that reference deleted products">
                        <i class="fas fa-broom"></i> Cleanup Deleted
                    </button>
                    <button class="btn-secondary" onclick="cleanupInactiveProducts()" title="Remove featured products that are inactive or out of stock">
                        <i class="fas fa-exclamation-triangle"></i> Cleanup Inactive
                    </button>
                    <button class="btn-primary" onclick="openAddProductModal()">
                        <i class="fas fa-plus"></i> Add Product
                    </button>
                </div>
            </div>

            <div class="admin-card">
                <div class="card-header">
                    <h2>Featured Products (Displayed on Home Page)</h2>
                    <p>Drag and drop to reorder. Maximum <span id="maxFeaturedCount">4</span> products will be displayed.</p>
                </div>

                <div id="featuredProductsGrid" class="product-grid">
                    <!-- JavaScript will populate this -->
                </div>
            </div>

            <div class="admin-card" style="margin-top: 30px;">
                <h3>Available Products</h3>
                <div class="filter-group">
                    <input type="text" id="productSearch" class="form-input" placeholder="Search products..." style="max-width: 300px;">
                </div>
                <div id="availableProductsGrid" class="product-grid" style="margin-top: 20px;">
                    <!-- JavaScript will populate this -->
                </div>
            </div>
        </main>
    </div>

    <!-- SortableJS for drag and drop -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    
    <!-- Featured Products Management JavaScript -->
    <script src="/js/admin/auth-utils.js"></script>
    <script src="/js/admin/featured-products.js?v=2"></script>

</body>
</html>

