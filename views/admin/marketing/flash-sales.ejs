<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flash Sales Management | Admin Panel</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <link rel="icon" type="image/svg+xml" href="/images/icons/Qualitick-01.svg">
    <link rel="apple-touch-icon" href="/images/icons/Qualitick-01.svg">

    <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
        <meta name="csrf-token" content="<%= csrfToken %>">
<% } %>
    <link rel="stylesheet" href="/css/admin/admin.css">
    <link rel="stylesheet" href="/css/admin/flash-sales.css">
</head>
<body class="admin-page">

<div class="admin-container">
    <%- include('../../partials/admin-sidebar', { activePage: 'marketing', activeSubPage: 'flash-sales' }) %>

    <main class="admin-main">
        <div class="fs-page">

            <!-- ── Page Header ───────────────────────────────────────── -->
            <div class="fs-header">
                <div class="fs-header-left">
                    <div class="fs-header-icon">
                        <i class="fas fa-bolt"></i>
                    </div>
                    <div class="fs-header-text">
                        <h1>Flash Sales</h1>
                        <p>Create time-limited promotions that drive urgency and boost conversions</p>
                    </div>
                </div>
                <button class="btn-primary fs-create-btn" onclick="openCreateFlashSaleModal()">
                    <i class="fas fa-plus"></i>
                    New Flash Sale
                </button>
            </div>

            <!-- ── Stats Row ─────────────────────────────────────────── -->
            <div class="fs-stats">
                <div class="fs-stat-card fs-stat--active">
                    <div class="fs-stat-icon-wrap">
                        <i class="fas fa-bolt"></i>
                    </div>
                    <div class="fs-stat-body">
                        <span class="fs-stat-value" id="statActive">—</span>
                        <span class="fs-stat-label">Active Now</span>
                    </div>
                    <div class="fs-stat-glow"></div>
                </div>
                <div class="fs-stat-card fs-stat--scheduled">
                    <div class="fs-stat-icon-wrap">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                    <div class="fs-stat-body">
                        <span class="fs-stat-value" id="statScheduled">—</span>
                        <span class="fs-stat-label">Scheduled</span>
                    </div>
                    <div class="fs-stat-glow"></div>
                </div>
                <div class="fs-stat-card fs-stat--ended">
                    <div class="fs-stat-icon-wrap">
                        <i class="fas fa-flag-checkered"></i>
                    </div>
                    <div class="fs-stat-body">
                        <span class="fs-stat-value" id="statEnded">—</span>
                        <span class="fs-stat-label">Ended</span>
                    </div>
                    <div class="fs-stat-glow"></div>
                </div>
            </div>

            <!-- ── Sales Table ───────────────────────────────────────── -->
            <div class="admin-card fs-table-card">
                <div class="fs-card-header">
                    <div class="fs-card-header-left">
                        <h2>All Flash Sales</h2>
                        <p class="fs-card-subtitle">Manage and monitor your promotional campaigns</p>
                    </div>
                    <div class="fs-filter-wrap">
                        <i class="fas fa-filter fs-filter-icon"></i>
                        <select id="statusFilter" class="fs-filter-select">
                            <option value="all">All Status</option>
                            <option value="active">Active</option>
                            <option value="scheduled">Scheduled</option>
                            <option value="ended">Ended</option>
                        </select>
                    </div>
                </div>
                <div class="table-container fs-table-container">
                    <table class="admin-table fs-table">
                        <thead>
                            <tr>
                                <th>Sale</th>
                                <th>Products</th>
                                <th>Discount</th>
                                <th>Duration</th>
                                <th>Time Left</th>
                                <th>Status</th>
                                <th class="fs-actions-th">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="flashSalesTableBody">
                            <tr>
                                <td colspan="7" class="fs-state-cell">
                                    <div class="fs-loading-state">
                                        <div class="fs-spinner"></div>
                                        <span>Loading flash sales…</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ── Features Grid ─────────────────────────────────────── -->
            <div class="fs-features">
                <div class="fs-feature">
                    <div class="fs-feature-icon fs-fi--timer">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="fs-feature-body">
                        <h4>Countdown Timers</h4>
                        <p>Real-time timers update automatically on the storefront.</p>
                    </div>
                    <span class="fs-feature-live">Live</span>
                </div>
                <div class="fs-feature">
                    <div class="fs-feature-icon fs-fi--stock">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="fs-feature-body">
                        <h4>Stock Alerts</h4>
                        <p>Low-stock warnings shown to customers during active sales.</p>
                    </div>
                    <span class="fs-feature-live">Live</span>
                </div>
                <div class="fs-feature">
                    <div class="fs-feature-icon fs-fi--schedule">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div class="fs-feature-body">
                        <h4>Auto Scheduling</h4>
                        <p>Sales start and stop automatically at configured times.</p>
                    </div>
                    <span class="fs-feature-live">Live</span>
                </div>
                <div class="fs-feature">
                    <div class="fs-feature-icon fs-fi--banner">
                        <i class="fas fa-image"></i>
                    </div>
                    <div class="fs-feature-body">
                        <h4>Banner Display</h4>
                        <p>Sale banners appear automatically on the home page.</p>
                    </div>
                    <span class="fs-feature-live">Live</span>
                </div>
            </div>

        </div><!-- /fs-page -->
    </main>
</div>

<!-- ── Delete Confirmation Modal ────────────────────────────────────── -->
<div id="deleteFlashSaleModal" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Delete Flash Sale</h2>
            <button class="modal-close" id="closeDeleteModal">&times;</button>
        </div>
        <div class="modal-body fs-delete-body">
            <div class="fs-delete-warning">
                <div class="fs-delete-warning-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="fs-delete-warning-text">
                    <p>This action <strong>cannot be undone</strong>. The sale and all its settings will be permanently removed.</p>
                    <p class="fs-delete-name">Deleting: <strong id="deleteFlashSaleName"></strong></p>
                </div>
            </div>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn-outline" id="cancelDeleteBtn">Cancel</button>
            <button type="button" class="btn-danger" id="confirmDeleteBtn">
                <i class="fas fa-trash"></i> Delete Permanently
            </button>
        </div>
    </div>
</div>

<!-- ── Create / Edit Flash Sale Modal ───────────────────────────────── -->
<div id="flashSaleModal" class="modal" style="display: none;">
    <div class="modal-content fs-modal-content">
        <div class="modal-header">
            <div class="fs-modal-title">
                <div class="fs-modal-title-icon">
                    <i class="fas fa-bolt"></i>
                </div>
                <h2 id="modalTitle">Create Flash Sale</h2>
            </div>
            <button class="modal-close" onclick="closeFlashSaleModal()">&times;</button>
        </div>

        <form id="flashSaleForm" onsubmit="saveFlashSale(event)">
            <div class="modal-body">
            <div class="fs-form-grid">

                <!-- Left column: sale details + settings -->
                <div class="fs-form-col">
                    <div class="fs-form-section">
                        <h4 class="fs-section-heading">
                            <i class="fas fa-tag"></i> Sale Details
                        </h4>
                        <div class="form-group">
                            <label>Sale Name <span class="fs-req">*</span></label>
                            <input type="text" id="saleName" class="form-input" required placeholder="e.g., Summer Flash Sale">
                        </div>
                        <div class="fs-date-row">
                            <div class="form-group">
                                <label>Start <span class="fs-req">*</span></label>
                                <input type="datetime-local" id="startDate" class="form-input" required>
                            </div>
                            <div class="form-group">
                                <label>End <span class="fs-req">*</span></label>
                                <input type="datetime-local" id="endDate" class="form-input" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Discount <span class="fs-req">*</span></label>
                            <div class="fs-discount-wrap">
                                <input type="number" id="discount" class="form-input" min="1" max="99" required placeholder="30">
                                <span class="fs-discount-unit">% OFF</span>
                            </div>
                        </div>
                    </div>

                    <div class="fs-form-section">
                        <h4 class="fs-section-heading">
                            <i class="fas fa-sliders-h"></i> Display Options
                        </h4>
                        <label class="fs-toggle">
                            <input type="checkbox" id="showBanner" checked class="fs-toggle-input">
                            <span class="fs-toggle-track"></span>
                            <span class="fs-toggle-label">Auto-display banner on home page</span>
                        </label>
                        <label class="fs-toggle">
                            <input type="checkbox" id="showStockAlert" class="fs-toggle-input">
                            <span class="fs-toggle-track"></span>
                            <span class="fs-toggle-label">Show limited stock alerts</span>
                        </label>
                        <div class="form-group" style="margin-top: 16px;">
                            <label>Banner Text <span class="fs-optional">(optional)</span></label>
                            <input type="text" id="bannerText" class="form-input" placeholder="e.g., Limited Time Only!">
                        </div>
                    </div>
                </div>

                <!-- Right column: product selector -->
                <div class="fs-form-col">
                    <div class="fs-form-section fs-products-section">
                        <h4 class="fs-section-heading">
                            <i class="fas fa-boxes"></i> Products <span class="fs-req">*</span>
                        </h4>
                        <p class="fs-section-hint">Search and select products to include in this sale. <strong>Max 4 products.</strong></p>
                        <div class="product-selector">
                            <div class="fs-search-wrap">
                                <i class="fas fa-search fs-search-icon"></i>
                                <input type="text" id="productSearch" class="form-input fs-search-input" placeholder="Search by product name…">
                            </div>
                            <div id="productList" class="product-list"></div>
                        </div>
                    </div>
                </div>

            </div>

            <input type="hidden" id="flashSaleId">
            </div><!-- /.modal-body -->

            <div class="modal-actions">
                <button type="button" class="btn-outline" onclick="closeFlashSaleModal()">Cancel</button>
                <button type="submit" class="btn-primary fs-save-btn">
                    <i class="fas fa-bolt"></i> Save Flash Sale
                </button>
            </div>
        </form>
    </div>
</div>

<script src="/js/admin/auth-utils.js"></script>
<script src="/js/admin/sidebar.js"></script>
<script src="/js/admin/orders-badge.js"></script>
<script src="/js/admin/flash-sales.js"></script>

</body>
</html>
