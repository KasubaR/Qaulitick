<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Qualitick Collections</title>
    
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/icons/Qualitick-01.svg">
    <link rel="apple-touch-icon" href="/images/icons/Qualitick-01.svg">
    
    <!-- Professional Admin Styles -->
    <link rel="stylesheet" href="/css/admin/admin-professional.css">
    <link rel="stylesheet" href="/css/admin/admin-components.css">
    <link rel="stylesheet" href="/css/admin/admin-responsive.css">
    <!-- Admin Dashboard Stylesheet -->
    <link rel="stylesheet" href="/css/admin/dashboard.css">
</head>
<body class="admin-page">

    <!-- ADMIN DASHBOARD -->
    <div class="admin-container">
        <!-- Sidebar Navigation -->
        <%- include('../partials/admin-sidebar', { activePage: 'dashboard' }) %>

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Header -->
            <header class="admin-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="page-title">Dashboard</h1>
                </div>
                
                <div class="header-right">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Search orders, products, customers..." id="adminSearch">
                    </div>
                    
                    <div class="header-actions">
                        <button class="icon-btn" id="notificationsBtn" title="Notifications">
                            <i class="fas fa-bell"></i>
                            <span class="notification-dot" id="notificationDot"></span>
                        </button>
                        
                        <div class="admin-profile">
                            <img src="/images/icons/Qualitick-01.svg" alt="Admin" class="profile-avatar">
                            <div class="profile-info">
                                <span class="profile-name"><%= typeof admin !== 'undefined' && admin ? (admin.name || 'Admin') : 'Admin' %></span>
                                <% if (typeof admin !== 'undefined' && admin && admin.email) { %>
                                <span class="profile-email"><%= admin.email %></span>
                                <% } %>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </header>

            <!-- Dashboard Content -->
            <div class="dashboard-content">
                <!-- KPI Cards -->
                <div class="kpi-grid">
                    <div class="kpi-card">
                        <div class="kpi-icon sales">
                            <i class="fas fa-dollar-sign"></i>
                        </div>
                        <div class="kpi-content">
                            <h3 class="kpi-label">Total Sales</h3>
                            <p class="kpi-value" id="totalSales">K0</p>
                            <span class="kpi-change positive" id="salesChange">
                                <i class="fas fa-arrow-up"></i> 0%
                            </span>
                        </div>
                    </div>

                    <div class="kpi-card">
                        <div class="kpi-icon orders">
                            <i class="fas fa-shopping-bag"></i>
                        </div>
                        <div class="kpi-content">
                            <h3 class="kpi-label">Total Orders</h3>
                            <p class="kpi-value" id="totalOrders">0</p>
                            <span class="kpi-change positive" id="ordersChange">
                                <i class="fas fa-arrow-up"></i> 0%
                            </span>
                        </div>
                    </div>

                    <div class="kpi-card">
                        <div class="kpi-icon customers">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="kpi-content">
                            <h3 class="kpi-label">Total Customers</h3>
                            <p class="kpi-value" id="totalCustomers">0</p>
                            <span class="kpi-change positive" id="customersChange">
                                <i class="fas fa-arrow-up"></i> 0%
                            </span>
                        </div>
                    </div>

                    <div class="kpi-card">
                        <div class="kpi-icon products">
                            <i class="fas fa-box"></i>
                        </div>
                        <div class="kpi-content">
                            <h3 class="kpi-label">Total Products</h3>
                            <p class="kpi-value" id="totalProducts">0</p>
                            <span class="kpi-change neutral" id="productsChange">
                                <i class="fas fa-minus"></i> 0%
                            </span>
                        </div>
                    </div>


                    <div class="kpi-card alert">
                        <div class="kpi-icon alerts">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div class="kpi-content">
                            <h3 class="kpi-label">Low Stock Alerts</h3>
                            <p class="kpi-value" id="lowStockCount">0</p>
                            <span class="kpi-change negative" id="stockChange">
                                <i class="fas fa-arrow-down"></i> Action Required
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Charts Section -->
                <div class="charts-grid">
                    <div class="chart-card">
                        <div class="card-header">
                            <h3>Sales Analytics</h3>
                            <div class="chart-controls">
                                <button class="chart-btn active" data-period="daily">Daily</button>
                                <button class="chart-btn" data-period="weekly">Weekly</button>
                                <button class="chart-btn" data-period="monthly">Monthly</button>
                            </div>
                        </div>
                        <div class="chart-container">
                            <canvas id="salesChart"></canvas>
                        </div>
                    </div>

                    <div class="chart-card">
                        <div class="card-header">
                            <h3>Revenue Trends</h3>
                        </div>
                        <div class="chart-container">
                            <canvas id="revenueChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Recent Orders & Low Stock Products -->
                <div class="tables-grid">
                    <!-- Recent Orders Table -->
                    <div class="table-card">
                        <div class="card-header">
                            <h3>Recent Orders</h3>
                            <a href="/admin/orders" class="view-all-link">View All</a>
                        </div>
                        <div class="table-container">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>Order #</th>
                                        <th>Customer</th>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="recentOrdersBody">
                                    <tr>
                                        <td colspan="6" class="empty-state">No orders yet</td>
                                    </tr>
                                </tbody>
                            </table>
                            <!-- Pagination Controls -->
                            <div class="pagination-container" id="recentOrdersPagination" style="display: none;">
                                <div class="pagination-info">
                                    <span id="recentOrdersPaginationInfo">Showing 0-0 of 0</span>
                                </div>
                                <div class="pagination-controls">
                                    <button class="pagination-btn" id="recentOrdersPrevBtn" disabled>
                                        <i class="fas fa-chevron-left"></i> Previous
                                    </button>
                                    <div class="pagination-pages" id="recentOrdersPages"></div>
                                    <button class="pagination-btn" id="recentOrdersNextBtn" disabled>
                                        Next <i class="fas fa-chevron-right"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Low Stock Products -->
                    <div class="table-card">
                        <div class="card-header">
                            <h3>Low Stock Alerts</h3>
                            <a href="/admin/inventory" class="view-all-link">View All</a>
                        </div>
                        <div class="table-container">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>SKU</th>
                                        <th>Stock</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="lowStockBody">
                                    <tr>
                                        <td colspan="5" class="empty-state">No low stock products</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Best Selling Products & Top Customers -->
                <div class="tables-grid">
                    <div class="table-card">
                        <div class="card-header">
                            <h3>Best Selling Products</h3>
                        </div>
                        <div class="table-container">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Sales</th>
                                        <th>Revenue</th>
                                        <th>Trend</th>
                                    </tr>
                                </thead>
                                <tbody id="bestSellingBody">
                                    <tr>
                                        <td colspan="4" class="empty-state">No data available</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="table-card">
                        <div class="card-header">
                            <h3>Top Customers</h3>
                        </div>
                        <div class="table-container">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>Customer</th>
                                        <th>Orders</th>
                                        <th>Total Spent</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody id="topCustomersBody">
                                    <tr>
                                        <td colspan="4" class="empty-state">No data available</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Notifications Dropdown -->
    <div class="notifications-dropdown" id="notificationsDropdown" style="display: none;">
        <div class="dropdown-header">
            <h4>Notifications</h4>
            <button class="mark-all-read" id="markAllReadBtn">Mark all as read</button>
        </div>
        <div class="notifications-list" id="notificationsList">
            <div class="notification-item">
                <div class="notification-icon">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="notification-content">
                    <p class="notification-text">New order received</p>
                    <span class="notification-time">2 minutes ago</span>
                </div>
            </div>
        </div>
        <div class="dropdown-footer">
            <a href="/admin/notifications">View all notifications</a>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script src="/js/admin/auth-utils.js"></script>
    <script src="/js/admin/sidebar.js"></script>
    <script src="/js/admin/orders-badge.js"></script>
    <script src="/js/admin/dashboard.js"></script>
</body>
</html>

