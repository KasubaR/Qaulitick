<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Qualitick Collections</title>
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/icons/Qualitick-01.svg">
    <link rel="apple-touch-icon" href="/images/icons/Qualitick-01.svg">
    
<!-- Professional Admin Styles -->
    <link rel="stylesheet" href="/css/admin/admin.css">
<!-- Admin Dashboard Stylesheet -->
</head>
<body class="admin-page">

    <!-- ADMIN DASHBOARD -->
    <div class="admin-container">
        <!-- Sidebar Navigation -->
        <%- include('../partials/admin-sidebar', { activePage: 'dashboard' }) %>

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Header -->
            <header class="admin-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="page-title">Dashboard</h1>
                </div>
                
                <div class="header-right">
                    <div class="header-actions">
                        <div class="admin-profile">
                            <img src="/images/icons/Qualitick-01.svg" alt="Admin" class="profile-avatar">
                            <div class="profile-info">
                                <span class="profile-name"><%= typeof admin !== 'undefined' && admin ? (admin.name || 'Admin') : 'Admin' %></span>
                                <% if (typeof admin !== 'undefined' && admin && admin.email) { %>
                                <span class="profile-email"><%= admin.email %></span>
                                <% } %>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </header>

            <!-- Dashboard Content -->
            <div class="dashboard-content">
                <!-- KPI Cards -->
                <div class="kpi-grid">
                    <%- include('../partials/admin-stat-card', {
                        label: 'Total Sales',
                        iconVariant: 'sales',
                        valueId: 'totalSales',
                        value: 'K0',
                        changeId: 'salesChange',
                        changeVariant: 'positive',
                        changeIcon: 'fa-arrow-up',
                        changeText: '0%'
                    }) %>
                    <%- include('../partials/admin-stat-card', {
                        label: 'Total Orders',
                        iconVariant: 'orders',
                        valueId: 'totalOrders',
                        value: '0',
                        changeId: 'ordersChange',
                        changeVariant: 'positive',
                        changeIcon: 'fa-arrow-up',
                        changeText: '0%'
                    }) %>
                    <%- include('../partials/admin-stat-card', {
                        label: 'Total Customers',
                        iconVariant: 'customers',
                        valueId: 'totalCustomers',
                        value: '0',
                        changeId: 'customersChange',
                        changeVariant: 'positive',
                        changeIcon: 'fa-arrow-up',
                        changeText: '0%'
                    }) %>
                    <%- include('../partials/admin-stat-card', {
                        label: 'Total Products',
                        iconVariant: 'products',
                        valueId: 'totalProducts',
                        value: '0',
                        changeId: 'productsChange',
                        changeVariant: 'neutral',
                        changeIcon: 'fa-minus',
                        changeText: '0%'
                    }) %>
                    <%- include('../partials/admin-stat-card', {
                        label: 'Low Stock Alerts',
                        iconVariant: 'alerts',
                        valueId: 'lowStockCount',
                        value: '0',
                        cardModifier: 'alert',
                        changeId: 'stockChange',
                        changeVariant: 'negative',
                        changeIcon: 'fa-arrow-down',
                        changeText: 'Action Required'
                    }) %>
                </div>

                <!-- Layby Overview -->
                <div class="table-card layby-overview-section">
                    <div class="card-header">
                        <h3><i class="fas fa-layer-group layby-overview-title-icon" aria-hidden="true"></i>Layby Overview</h3>
                        <a href="/admin/layby" class="view-all-link">View All</a>
                    </div>
                    <div class="layby-stat-grid">
                        <div class="layby-stat-card">
                            <div class="layby-stat-icon layby-icon-outstanding">
                                <i class="fas fa-wallet"></i>
                            </div>
                            <div class="layby-stat-info">
                                <span class="layby-stat-label">Outstanding Payments</span>
                                <span class="layby-stat-value" id="laybyOutstanding">K0.00</span>
                            </div>
                        </div>
                        <div class="layby-stat-card">
                            <div class="layby-stat-icon layby-icon-overdue">
                                <i class="fas fa-exclamation-triangle"></i>
                            </div>
                            <div class="layby-stat-info">
                                <span class="layby-stat-label">Overdue</span>
                                <span class="layby-stat-value" id="laybyOverdue">0</span>
                            </div>
                        </div>
                        <div class="layby-stat-card">
                            <div class="layby-stat-icon layby-icon-completed">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="layby-stat-info">
                                <span class="layby-stat-label">Completed</span>
                                <span class="layby-stat-value" id="laybyCompleted">0</span>
                            </div>
                        </div>
                        <div class="layby-stat-card">
                            <div class="layby-stat-icon layby-icon-active">
                                <i class="fas fa-shopping-bag"></i>
                            </div>
                            <div class="layby-stat-info">
                                <span class="layby-stat-label">Active Layby Orders</span>
                                <span class="layby-stat-value" id="laybyActive">0</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Charts Section -->
                <div class="charts-grid">
                    <div class="chart-card">
                        <div class="card-header">
                            <h3>Sales Analytics</h3>
                            <div class="chart-controls">
                                <button class="chart-btn active" data-period="daily">Daily</button>
                                <button class="chart-btn" data-period="weekly">Weekly</button>
                                <button class="chart-btn" data-period="monthly">Monthly</button>
                            </div>
                        </div>
                        <div class="chart-container">
                            <canvas id="salesChart"></canvas>
                        </div>
                    </div>

                    <div class="chart-card">
                        <div class="card-header">
                            <h3>Revenue Trends</h3>
                        </div>
                        <div class="chart-container">
                            <canvas id="revenueChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Recent Orders & Low Stock Products -->
                <div class="tables-grid">
                    <!-- Recent Orders Table -->
                    <div class="table-card">
                        <div class="card-header">
                            <h3>Recent Orders</h3>
                            <a href="/admin/orders" class="view-all-link">View All</a>
                        </div>
                        <div class="table-container">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>Order #</th>
                                        <th>Customer</th>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="recentOrdersBody">
                                    <tr>
                                        <td colspan="6" class="empty-state">No orders yet</td>
                                    </tr>
                                </tbody>
                            </table>
                            <!-- Pagination Controls -->
                            <div class="pagination-container" id="recentOrdersPagination" style="display: none;">
                                <div class="pagination-info">
                                    <span id="recentOrdersPaginationInfo">Showing 0-0 of 0</span>
                                </div>
                                <div class="pagination-controls">
                                    <button class="pagination-btn" id="recentOrdersPrevBtn" disabled>
                                        <i class="fas fa-chevron-left"></i> Previous
                                    </button>
                                    <div class="pagination-pages" id="recentOrdersPages"></div>
                                    <button class="pagination-btn" id="recentOrdersNextBtn" disabled>
                                        Next <i class="fas fa-chevron-right"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Low Stock Products -->
                    <div class="table-card">
                        <div class="card-header">
                            <h3>Low Stock Alerts</h3>
                            <a href="/admin/inventory" class="view-all-link">View All</a>
                        </div>
                        <div class="table-container">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>SKU</th>
                                        <th>Stock</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="lowStockBody">
                                    <tr>
                                        <td colspan="5" class="empty-state">No low stock products</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Best Selling Products & Top Customers -->
                <div class="tables-grid">
                    <div class="table-card">
                        <div class="card-header">
                            <h3>Best Selling Products</h3>
                        </div>
                        <div class="table-container">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Sales</th>
                                        <th>Revenue</th>
                                        <th>Trend</th>
                                    </tr>
                                </thead>
                                <tbody id="bestSellingBody">
                                    <tr>
                                        <td colspan="4" class="empty-state">No data available</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="table-card">
                        <div class="card-header">
                            <h3>Top Customers</h3>
                        </div>
                        <div class="table-container">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>Customer</th>
                                        <th>Orders</th>
                                        <th>Total Spent</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody id="topCustomersBody">
                                    <tr>
                                        <td colspan="4" class="empty-state">No data available</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script src="/js/admin/auth-utils.js"></script>
    <script src="/js/admin/sidebar.js"></script>
    <script src="/js/admin/orders-badge.js"></script>
    <script src="/js/admin/dashboard.js"></script>
</body>
</html>

