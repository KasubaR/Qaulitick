<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings | Admin Panel</title>
    
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/icons/Qualitick-01.svg">
    <link rel="apple-touch-icon" href="/images/icons/Qualitick-01.svg">
    
    <!-- Professional Admin Styles -->
    <link rel="stylesheet" href="/css/admin/admin-professional.css">
    <link rel="stylesheet" href="/css/admin/admin-components.css">
    <link rel="stylesheet" href="/css/admin/admin-responsive.css">
    <!-- Admin Dashboard Stylesheet -->
    <link rel="stylesheet" href="/css/admin/dashboard.css">
    <!-- Admin Settings Stylesheet -->
    <link rel="stylesheet" href="/css/admin/settings.css">
</head>
<body class="admin-page">
    <!-- ADMIN SETTINGS PAGE -->
    <div class="admin-container">
        <!-- Sidebar Navigation -->
        <%- include('../partials/admin-sidebar', { activePage: 'settings' }) %>

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Header -->
            <header class="admin-header">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h1 class="page-title">Settings</h1>
                </div>
                
                <div class="header-right">
                    <button class="btn-outline" id="resetSettingsBtn">
                        <i class="fas fa-undo"></i> Reset Changes
                    </button>
                </div>
            </header>

            <!-- Settings Content -->
            <div class="settings-content">
                <!-- Settings Navigation Tabs -->
                <div class="settings-tabs">
                    <button class="settings-tab active" data-tab="general">
                        <i class="fas fa-cog"></i> General
                    </button>
                    <button class="settings-tab" data-tab="security">
                        <i class="fas fa-shield-alt"></i> Security
                    </button>
                    <button class="settings-tab" data-tab="notifications">
                        <i class="fas fa-bell"></i> Notifications
                    </button>
                </div>

                <!-- Settings Forms -->
                <div class="settings-forms">
                    <!-- General Settings -->
                    <div class="settings-pane active" id="generalPane">
                        <div class="settings-section">
                            <h2 class="section-title">
                                <i class="fas fa-cog"></i> General Settings
                            </h2>
                            
                            <form id="generalSettingsForm" class="settings-form">
                                <div class="form-group">
                                    <label for="siteName">Site Name</label>
                                    <input type="text" id="siteName" name="siteName" class="form-input" 
                                           placeholder="Qualitick Collections" value="">
                                </div>

                                <div class="form-group">
                                    <label for="siteUrl">Site URL</label>
                                    <input type="url" id="siteUrl" name="siteUrl" class="form-input" 
                                           placeholder="https://qualitick-collections.com" value="">
                                </div>

                                <div class="form-group">
                                    <label for="adminEmail">Admin Email</label>
                                    <input type="email" id="adminEmail" name="adminEmail" class="form-input" 
                                           placeholder="admin@qualitick-collections.com" value="">
                                </div>

                                <div class="form-group">
                                    <label for="timezone">Timezone</label>
                                    <select id="timezone" name="timezone" class="form-select">
                                        <option value="Africa/Lusaka">Africa/Lusaka (GMT+2)</option>
                                        <option value="UTC">UTC (GMT+0)</option>
                                        <option value="America/New_York">America/New_York (GMT-5)</option>
                                        <option value="Europe/London">Europe/London (GMT+0)</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="currency">Default Currency</label>
                                    <select id="currency" name="currency" class="form-select">
                                        <option value="ZMW" selected>ZMW - Zambian Kwacha</option>
                                        <option value="USD">USD - US Dollar</option>
                                        <option value="EUR">EUR - Euro</option>
                                        <option value="GBP">GBP - British Pound</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="language">Default Language</label>
                                    <select id="language" name="language" class="form-select">
                                        <option value="en" selected>English</option>
                                        <option value="es">Spanish</option>
                                        <option value="fr">French</option>
                                    </select>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn-primary">
                                        <i class="fas fa-save"></i> Save General Settings
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Security Settings -->
                    <div class="settings-pane" id="securityPane">
                        <div class="settings-section">
                            <h2 class="section-title">
                                <i class="fas fa-shield-alt"></i> Security Settings
                            </h2>
                            
                            <form id="securitySettingsForm" class="settings-form">
                                <div class="form-group">
                                    <label for="sessionTimeout">Session Timeout (minutes)</label>
                                    <input type="number" id="sessionTimeout" name="sessionTimeout" class="form-input" 
                                           placeholder="30" value="30" min="5" max="1440">
                                    <small class="form-help">Time before admin session expires (5-1440 minutes)</small>
                                </div>

                                <div class="form-group">
                                    <label for="maxLoginAttempts">Max Login Attempts</label>
                                    <input type="number" id="maxLoginAttempts" name="maxLoginAttempts" class="form-input" 
                                           placeholder="5" value="5" min="3" max="10">
                                    <small class="form-help">Maximum failed login attempts before account lockout</small>
                                </div>

                                <div class="form-group">
                                    <label for="requireStrongPassword">Require Strong Passwords</label>
                                    <div class="checkbox-group">
                                        <input type="checkbox" id="requireStrongPassword" name="requireStrongPassword" class="form-checkbox" checked>
                                        <label for="requireStrongPassword">Enforce strong password policy</label>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="enable2FA">Enable Two-Factor Authentication</label>
                                    <div class="checkbox-group">
                                        <input type="checkbox" id="enable2FA" name="enable2FA" class="form-checkbox">
                                        <label for="enable2FA">Require 2FA for admin accounts</label>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="enableCSP">Enable Content Security Policy</label>
                                    <div class="checkbox-group">
                                        <input type="checkbox" id="enableCSP" name="enableCSP" class="form-checkbox" checked>
                                        <label for="enableCSP">Protect against XSS attacks</label>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="enableRateLimiting">Enable Rate Limiting</label>
                                    <div class="checkbox-group">
                                        <input type="checkbox" id="enableRateLimiting" name="enableRateLimiting" class="form-checkbox" checked>
                                        <label for="enableRateLimiting">Protect against brute force attacks</label>
                                    </div>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn-primary">
                                        <i class="fas fa-save"></i> Save Security Settings
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Notification Settings -->
                    <div class="settings-pane" id="notificationsPane">
                        <div class="settings-section">
                            <h2 class="section-title">
                                <i class="fas fa-bell"></i> Notification Settings
                            </h2>
                            
                            <form id="notificationSettingsForm" class="settings-form">
                                <div class="form-group">
                                    <label>Email Notifications</label>
                                    <div class="checkbox-group">
                                        <input type="checkbox" id="notifyNewOrders" name="notifyNewOrders" class="form-checkbox" checked>
                                        <label for="notifyNewOrders">New Order Notifications</label>
                                    </div>
                                    <div class="checkbox-group">
                                        <input type="checkbox" id="notifyLowStock" name="notifyLowStock" class="form-checkbox" checked>
                                        <label for="notifyLowStock">Low Stock Alerts</label>
                                    </div>
                                    <div class="checkbox-group">
                                        <input type="checkbox" id="notifyPayments" name="notifyPayments" class="form-checkbox" checked>
                                        <label for="notifyPayments">Payment Notifications</label>
                                    </div>
                                    <div class="checkbox-group">
                                        <input type="checkbox" id="notifyContactSubmissions" name="notifyContactSubmissions" class="form-checkbox" checked>
                                        <label for="notifyContactSubmissions">Contact Form Submissions</label>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="notificationEmail">Notification Email Address</label>
                                    <input type="email" id="notificationEmail" name="notificationEmail" class="form-input" 
                                           placeholder="notifications@qualitick-collections.com" value="">
                                    <small class="form-help">Email address to receive admin notifications</small>
                                </div>

                                <div class="form-group">
                                    <label>In-App Notifications</label>
                                    <div class="checkbox-group">
                                        <input type="checkbox" id="showOrderBadges" name="showOrderBadges" class="form-checkbox" checked>
                                        <label for="showOrderBadges">Show order count badges</label>
                                    </div>
                                    <div class="checkbox-group">
                                        <input type="checkbox" id="showStockAlerts" name="showStockAlerts" class="form-checkbox" checked>
                                        <label for="showStockAlerts">Show stock alerts</label>
                                    </div>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn-primary">
                                        <i class="fas fa-save"></i> Save Notification Settings
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="/js/admin/auth-utils.js"></script>
    <script src="/js/admin/sidebar.js"></script>
    <script src="/js/admin/orders-badge.js"></script>
    <script src="/js/admin/admin-settings.api.js"></script>
    <script src="/js/admin/settings.js"></script>
</body>
</html>

