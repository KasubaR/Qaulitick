<!-- HOW LAYBY WORKS PAGE -->

<!-- ── HERO ── -->
<section class="about-hero layby-hero">
    <div class="about-hero-inner">
        <span class="about-eyebrow">Flexible Payment Plan</span>
        <h1 class="about-hero-title">Own Your Dream Watch<br><em>On Your Terms</em></h1>
