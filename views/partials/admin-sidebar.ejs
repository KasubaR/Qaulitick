<!-- Sidebar Navigation -->
<aside class="admin-sidebar" id="adminSidebar">
    <!-- Sidebar Toggle Button -->
    <button class="sidebar-collapse-btn" id="sidebarCollapseBtn" title="Toggle Sidebar">
        <i class="fas fa-chevron-left"></i>
    </button>
    
    <nav class="sidebar-nav">
        <a href="/admin/dashboard" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
            <i class="fas fa-chart-line"></i>
            <span>Dashboard</span>
        </a>
        <a href="/admin/products" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'products' ? 'active' : '' %>">
            <i class="fas fa-box"></i>
            <span>Products</span>
        </a>
        <a href="/admin/orders" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'orders' ? 'active' : '' %>">
            <i class="fas fa-shopping-cart"></i>
            <span>Orders</span>
            <span class="badge" id="newOrdersBadge">0</span>
        </a>
        <a href="/admin/layby" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'layby' ? 'active' : '' %>">
            <i class="fas fa-calendar-check"></i>
            <span>Layby</span>
        </a>
        <a href="/admin/contact-submissions" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'contact-submissions' ? 'active' : '' %>">
            <i class="fas fa-envelope"></i>
            <span>Contact Submissions</span>
            <span class="badge" id="newSubmissionsBadge"><%= typeof newSubmissionsCount !== 'undefined' ? newSubmissionsCount : 0 %></span>
        </a>
        <a href="/admin/customers" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'customers' ? 'active' : '' %>">
            <i class="fas fa-users"></i>
            <span>Customers</span>
        </a>
        <a href="/admin/inventory" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'inventory' ? 'active' : '' %>">
            <i class="fas fa-warehouse"></i>
            <span>Inventory</span>
            <span class="badge alert" id="lowStockBadge">0</span>
        </a>
        <a href="/admin/payments" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'payments' ? 'active' : '' %>">
            <i class="fas fa-credit-card"></i>
            <span>Payments</span>
        </a>
        <a href="/admin/marketing" class="nav-item <%= (typeof activePage !== 'undefined' && activePage === 'marketing') || (typeof activeSubPage !== 'undefined' && ['flash-sales', 'featured-products'].includes(activeSubPage)) ? 'active' : '' %>">
            <i class="fas fa-bullhorn"></i>
            <span>Marketing</span>
        </a>
        <a href="/admin/analytics" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'analytics' ? 'active' : '' %>">
            <i class="fas fa-chart-bar"></i>
            <span>Analytics</span>
        </a>
        <a href="/admin/settings" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'settings' ? 'active' : '' %>">
            <i class="fas fa-cog"></i>
            <span>Settings</span>
        </a>
        <a href="/admin/logs" class="nav-item <%= typeof activePage !== 'undefined' && activePage === 'logs' ? 'active' : '' %>">
            <i class="fas fa-history"></i>
            <span>Logs</span>
        </a>
        
        <!-- Separator -->
        <div class="nav-separator"></div>
        
        <!-- Admin Info (if authenticated) -->
        <% if (typeof admin !== 'undefined' && admin) { %>
        <div class="nav-item admin-info">
            <div class="admin-info-avatar">
                <i class="fas fa-user-shield"></i>
            </div>
            <div class="admin-info-details">
                <span class="admin-info-name"><%= admin.name || 'Admin' %></span>
                <span class="admin-info-email"><%= admin.email %></span>
            </div>
        </div>
        <% } %>
        
        <!-- Back to Site -->
        <a href="/" class="nav-item" target="_blank" rel="noopener noreferrer">
            <i class="fas fa-home"></i>
            <span>Back to Site</span>
        </a>
        
        <!-- Logout -->
        <form method="POST" action="/admin/logout" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="nav-item logout">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </button>
        </form>
    </nav>
</aside>

