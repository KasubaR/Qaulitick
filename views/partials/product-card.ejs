<%
    // Normalize images: product.images can be a stringified JSON (DB) or an array
    let _imgs = product.images;
    if (typeof _imgs === 'string') {
        try { _imgs = JSON.parse(_imgs); } catch (e) { _imgs = []; }
    }
    if (!Array.isArray(_imgs)) _imgs = [];
    const _firstImage = _imgs[0] || '/images/placeholder.jpg';

    const _discount = Number(product.discount) || 0;
    const _productId = product._id || product.id;
    const _productUrl = '/product/' + _productId;
%>

<div class="shop-product-card">
    <div class="product-image-wrapper">
        <% if (_discount > 0) { %>
            <span class="discount-badge">-<%= _discount %>%</span>
        <% } %>
        <% if (product.stockStatus === 'out-of-stock') { %>
            <div class="out-of-stock-overlay">Out of Stock</div>
        <% } else if (product.stockStatus === 'low-stock') { %>
            <div class="low-stock-badge">Only <%= (typeof product.availableStock === 'number' ? product.availableStock : product.stock) %> left</div>
        <% } %>
        <div class="product-image">
            <a href="<%= _productUrl %>" class="product-link product-link--media">
                <img
                    src="<%= _firstImage %>"
                    alt="<%= product.model %>"
                    loading="lazy"
                    decoding="async"
                    width="400"
                    height="400"
                >
            </a>
            <div class="product-actions">
                <button
                    type="button"
                    class="quick-view-btn"
                    data-product-id="<%= _productId %>"
                    aria-label="Quick view: <%= product.model %>"
                >
                    <i class="fas fa-eye" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>

    <a href="<%= _productUrl %>" class="product-link product-link--info">
        <div class="product-info">
            <div class="product-brand"><%= product.brand || 'Brand' %></div>
            <h3 class="product-name"><%= product.model %></h3>
            <div class="product-rating">
                <%- include('star-rating', { rating: product.rating }) %>
                <span class="rating-value">(<%= product.rating || 0 %>)</span>
            </div>

            <div class="product-price">
                <% if (_discount > 0) { %>
                    <span class="original-price">K<%= (product.originalPrice || product.price || 0).toLocaleString() %></span>
                    <span class="current-price" data-final-price="<%= product.finalPrice || product.price || 0 %>">K<%= (product.finalPrice || product.price || 0).toLocaleString() %></span>
                <% } else { %>
                    <span class="current-price" data-final-price="<%= product.finalPrice || product.price || 0 %>">K<%= (product.finalPrice || product.price || 0).toLocaleString() %></span>
                <% } %>
            </div>

            <div class="product-meta">
                <span class="product-strap">
                    <i class="fas fa-link"></i>
                    <%= product.strapType || 'N/A' %>
                </span>
            </div>
        </div>
    </a>
</div>
