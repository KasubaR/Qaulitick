<%- include('../partials/header', {
    title: typeof title !== 'undefined' ? title : 'Sign in | Qualitick Collections',
    page: 'account',
    canonicalUrl: typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://qualitick-collections.com/login',
    url: '/login'
}) %>

<div class="account-page-wrap">
    <div class="account-hero">
        <h1>Sign in</h1>
        <p>Access your orders, layby plans, and profile.</p>
    </div>

    <div class="account-card account-form">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="account-alert account-alert--error" role="alert"><%= error %></div>
        <% } %>
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="account-alert account-alert--info" role="status"><%= message %></div>
        <% } %>

        <form method="post" action="/login" novalidate>
            <input type="hidden" name="csrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input type="hidden" name="returnUrl" value="<%= typeof returnUrl !== 'undefined' ? returnUrl : '/account' %>">

            <div class="form-group">
                <label for="loginEmail">Email <span class="required">*</span></label>
                <input type="email" id="loginEmail" name="email" required autocomplete="email">
            </div>

            <div class="form-group">
                <label for="loginPassword">Password <span class="required">*</span></label>
                <input type="password" id="loginPassword" name="password" required autocomplete="current-password">
                <p class="account-form-hint"><a href="/forgot-password">Forgot password?</a></p>
            </div>

            <div class="form-group">
                <label class="account-checkbox">
                    <input type="checkbox" name="remember" value="on">
                    <span>Remember me on this device</span>
                </label>
            </div>

            <div class="account-actions">
                <button type="submit" class="account-btn-primary">Sign in</button>
                <span class="account-auth-switch">New here? <a href="/register">Create an account</a></span>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
