<%- include('../partials/header', {
    title: typeof title !== 'undefined' ? title : 'Create account | Qualitick Collections',
    page: 'account',
    canonicalUrl: typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://qualitick-collections.com/register',
    url: '/register'
}) %>

<div class="account-page-wrap">
    <div class="account-hero">
        <h1>Create account</h1>
        <p>Register to track orders, manage layby plans, and speed up checkout.</p>
    </div>

    <div class="account-card account-form">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="account-alert account-alert--error" role="alert"><%= error %></div>
        <% } %>

        <form method="post" action="/register" novalidate>
            <input type="hidden" name="csrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

            <div class="form-group">
                <label for="regName">Full name <span class="required">*</span></label>
                <input type="text" id="regName" name="name" required autocomplete="name" value="<%= typeof form !== 'undefined' && form.name ? form.name : '' %>">
            </div>

            <div class="form-group">
                <label for="regEmail">Email <span class="required">*</span></label>
                <input type="email" id="regEmail" name="email" required autocomplete="email" value="<%= typeof form !== 'undefined' && form.email ? form.email : '' %>">
            </div>

            <div class="form-group">
                <label for="regPhone">Phone <span class="required">*</span></label>
                <input type="tel" id="regPhone" name="phone" required autocomplete="tel" placeholder="+260 or 0…" value="<%= typeof form !== 'undefined' && form.phone ? form.phone : '' %>">
            </div>

            <div class="form-group">
                <label for="regPassword">Password <span class="required">*</span></label>
                <input type="password" id="regPassword" name="password" required autocomplete="new-password" minlength="8">
                <p class="account-form-hint">At least 8 characters, with at least one letter and one number.</p>
            </div>

            <div class="form-group">
                <label for="regConfirmPassword">Confirm password <span class="required">*</span></label>
                <input type="password" id="regConfirmPassword" name="confirmPassword" required autocomplete="new-password" minlength="8">
            </div>

            <div class="account-actions">
                <button type="submit" class="account-btn-primary">Create account</button>
                <span class="account-auth-switch">Already have an account? <a href="/login">Sign in</a></span>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
