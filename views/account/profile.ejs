<%- include('../partials/header', {
    title: typeof title !== 'undefined' ? title : 'Profile | Qualitick Collections',
    page: 'account',
    canonicalUrl: typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://qualitick-collections.com/account/profile',
    url: '/account/profile'
}) %>

<div class="account-page-wrap">
    <div class="account-hero">
        <h1>Profile</h1>
        <p>Update your contact details. Email cannot be changed here.</p>
    </div>

    <%- include('./_subnav') %>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="account-alert account-alert--error" role="alert"><%= error %></div>
    <% } %>
    <% if (typeof message !== 'undefined' && message) { %>
        <div class="account-alert account-alert--success" role="status"><%= message %></div>
    <% } %>
    <% if (typeof securityError !== 'undefined' && securityError) { %>
        <div class="account-alert account-alert--error" role="alert"><%= securityError %></div>
    <% } %>
    <% if (typeof securityMessage !== 'undefined' && securityMessage) { %>
        <div class="account-alert account-alert--success" role="status"><%= securityMessage %></div>
    <% } %>

    <div class="account-card account-form">
        <form method="post" action="/account/profile" novalidate>
            <input type="hidden" name="csrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

            <div class="form-group">
                <label for="profileName">Full name <span class="required">*</span></label>
                <input type="text" id="profileName" name="name" required autocomplete="name" value="<%= typeof customer !== 'undefined' && customer.name ? customer.name : '' %>">
            </div>

            <div class="form-group">
                <label for="profileEmail">Email</label>
                <input type="email" id="profileEmail" name="email" readonly disabled value="<%= typeof customer !== 'undefined' && customer.email ? customer.email : '' %>">
            </div>

            <div class="form-group">
                <label for="profilePhone">Phone</label>
                <input type="tel" id="profilePhone" name="phone" autocomplete="tel" placeholder="+260 or 0…" value="<%= typeof customer !== 'undefined' && customer.phone ? customer.phone : '' %>">
            </div>

            <div class="account-actions">
                <button type="submit" class="account-btn-primary">Save changes</button>
            </div>
        </form>
    </div>

    <div class="account-card account-form" id="security">
        <h2>Security</h2>
        <p class="account-form-hint">Use a strong password with at least 8 characters, one letter, and one number.</p>
        <form method="post" action="/account/password" novalidate>
            <input type="hidden" name="csrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="form-group">
                <label for="currentPassword">Current password <span class="required">*</span></label>
                <input type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" required minlength="8" maxlength="128">
            </div>
            <div class="form-group">
                <label for="newPassword">New password <span class="required">*</span></label>
                <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" required minlength="8" maxlength="128">
            </div>
            <div class="form-group">
                <label for="confirmPassword">Confirm new password <span class="required">*</span></label>
                <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required minlength="8" maxlength="128">
            </div>
            <div class="account-actions">
                <button type="submit" class="account-btn-primary">Update password</button>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
