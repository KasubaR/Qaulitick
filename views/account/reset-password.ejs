<%- include('../partials/header', {
    title: typeof title !== 'undefined' ? title : 'Reset password | Qualitick Collections',
    page: 'account',
    canonicalUrl: typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://qualitick-collections.com/reset-password',
    url: '/reset-password'
}) %>

<div class="account-page-wrap">
    <div class="account-hero">
        <h1>Reset password</h1>
        <p>Choose a new password for your account.</p>
    </div>

    <div class="account-card account-form">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="account-alert account-alert--error" role="alert"><%= error %></div>
        <% } %>

        <% if (typeof invalid !== 'undefined' && invalid) { %>
            <p class="account-auth-switch"><a href="/forgot-password">Request a new reset link</a> · <a href="/login">Sign in</a></p>
        <% } else { %>
            <form method="post" action="/reset-password" novalidate>
                <input type="hidden" name="csrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="hidden" name="token" value="<%= typeof token !== 'undefined' && token ? token : '' %>">

                <div class="form-group">
                    <label for="resetPassword">New password <span class="required">*</span></label>
                    <input type="password" id="resetPassword" name="password" required autocomplete="new-password" minlength="8">
                    <p class="account-form-hint">At least 8 characters, with at least one letter and one number.</p>
                </div>

                <div class="form-group">
                    <label for="resetPasswordConfirm">Confirm new password <span class="required">*</span></label>
                    <input type="password" id="resetPasswordConfirm" name="passwordConfirm" required autocomplete="new-password" minlength="8">
                </div>

                <div class="account-actions">
                    <button type="submit" class="account-btn-primary">Update password</button>
                    <span class="account-auth-switch"><a href="/login">Cancel</a></span>
                </div>
            </form>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
