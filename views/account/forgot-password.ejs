<%- include('../partials/header', {
    title: typeof title !== 'undefined' ? title : 'Forgot password | Qualitick Collections',
    page: 'account',
    canonicalUrl: typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://qualitick-collections.com/forgot-password',
    url: '/forgot-password'
}) %>

<div class="account-page-wrap">
    <div class="account-hero">
        <h1>Forgot password</h1>
        <p>Enter your account email and we will send you a link to choose a new password.</p>
    </div>

    <div class="account-card account-form">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="account-alert account-alert--error" role="alert"><%= error %></div>
        <% } %>
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="account-alert account-alert--success" role="status"><%= message %></div>
        <% } %>

        <form method="post" action="/forgot-password" novalidate>
            <input type="hidden" name="csrfToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

            <div class="form-group">
                <label for="forgotEmail">Email <span class="required">*</span></label>
                <input type="email" id="forgotEmail" name="email" required autocomplete="email" value="<%= typeof form !== 'undefined' && form.email ? form.email : '' %>">
            </div>

            <div class="account-actions">
                <button type="submit" class="account-btn-primary">Send reset link</button>
                <span class="account-auth-switch"><a href="/login">Back to sign in</a></span>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
