<%
// Normalize product.images to always be an array (MySQL JSON field can return a string)
if (typeof product.images === 'string') {
    try { product.images = JSON.parse(product.images); } catch(e) { product.images = []; }
}
if (!Array.isArray(product.images)) product.images = [];
// Colors may be objects { name, image } or legacy strings; images may use image / imageUrl / img
const normalizedColors = (product.colors || []).map(function (c) {
    if (typeof c === 'string') return { name: c, image: '' };
    const img = c.image || c.imageUrl || c.img || '';
    return { name: (c.name || '').trim(), image: typeof img === 'string' ? img.trim() : '' };
}).filter(function (c) { return c.name; });
%>
<%- include('partials/header', {
    title: typeof title !== 'undefined' ? title : 'Product Details - ' + product.model,
    page: 'product',
    description: typeof description !== 'undefined' ? description : product.description,
    keywords: typeof keywords !== 'undefined' ? keywords : '',
    canonicalUrl: typeof canonicalUrl !== 'undefined' ? canonicalUrl : '',
    ogImage: typeof ogImage !== 'undefined' ? ogImage : (product.images[0] || ''),
    ogType: typeof ogType !== 'undefined' ? ogType : 'product',
    url: typeof url !== 'undefined' ? url : ''
}) %>

    <!-- BREADCRUMB -->
    <div class="breadcrumb">
        <div class="breadcrumb-container">
            <a href="/">Home</a>
            <span class="breadcrumb-separator">›</span>
            <a href="/shop">Shop</a>
            <span class="breadcrumb-separator">›</span>
            <span class="breadcrumb-current"><%= product.model %></span>
        </div>
    </div>

    <!-- PRODUCT DETAILS SECTION -->
    <section class="product-details-section">
        <div class="product-container">
            
            <!-- PRODUCT GALLERY -->
            <div class="product-gallery">
                <!-- Main Image Display -->
                <div class="main-image-container">
                    <% if ((typeof product.availableStock === 'number' ? product.availableStock : product.stock) <= 0) { %>
                        <div class="out-of-stock-overlay">OUT OF STOCK</div>
                    <% } %>
                    <% if (product.discount > 0) { %>
                        <div class="discount-badge">-<%= product.discount %>%</div>
                    <% } %>
                    <img 
                        id="mainImage" 
                        src="<%= product.images[0] %>" 
                        alt="<%= product.model %>"
                        class="main-image"
                    >
                    <button class="zoom-btn" id="zoomBtn" aria-label="Zoom image">
                        <i class="fas fa-search-plus"></i>
                    </button>
                </div>
                
                <!-- Image Thumbnails -->
                <div class="thumbnail-container">
                    <% product.images.forEach((image, index) => { %>
                        <div class="thumbnail <%= index === 0 ? 'active' : '' %>" data-index="<%= index %>">
                            <img src="<%= image %>" alt="<%= product.model %> view <%= index + 1 %>">
                        </div>
                    <% }) %>
                    
                    <% if (product.videoUrl) { %>
                        <div class="thumbnail video-thumbnail" data-video="true">
                            <i class="fas fa-play-circle"></i>
                            <span>Video</span>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- PRODUCT INFO -->
            <div class="product-info-section">
                <div class="product-header">
                    <div class="brand-tag"><%= product.brand %></div>
                    <h1 class="product-title"><%= product.model %></h1>
                    
                    <!-- Rating & Reviews -->
                    <div class="product-rating">
                        <div class="stars">
                            <%- include('partials/star-rating', { rating: product.rating }) %>
                        </div>
                        <span class="rating-value"><%= product.rating %></span>
                        <span class="review-count">(<%= product.reviews && product.reviews.length ? product.reviews.length : 0 %> reviews)</span>
                    </div>

                    <!-- SKU & Availability -->
                    <div class="product-meta">
                        <span class="sku">SKU: <span class="meta-value"><%= product.sku || product._id %></span></span>
                        <span class="availability">
                            <% if (product.stockStatus === 'in-stock') { %>
                                <i class="fas fa-check-circle"></i> In Stock
                            <% } else if (product.stockStatus === 'low-stock') { %>
                                <i class="fas fa-exclamation-circle"></i> Low Stock (<%= typeof product.availableStock === 'number' ? product.availableStock : product.stock %> left)
                            <% } else { %>
                                <i class="fas fa-times-circle"></i> Out of Stock
                            <% } %>
                        </span>
                    </div>
                </div>

                <!-- PRICE -->
                <div class="price-section">
                    <% if (product.discount > 0) { %>
                        <div class="price-row">
                            <span class="original-price">K<%= (product.originalPrice || product.price || 0).toLocaleString() %></span>
                            <span class="discount-tag">-<%= product.discount %>% OFF</span>
                        </div>
                        <div class="current-price" data-final-price="<%= product.finalPrice || product.price || 0 %>">
                            K<%= (product.finalPrice || product.price || 0).toLocaleString() %>
                        </div>
                        <% if (product.savings > 0) { %>
                            <p class="savings-info">You save K<%= product.savings.toLocaleString() %></p>
                        <% } %>
                    <% } else { %>
                        <div class="current-price" data-final-price="<%= product.finalPrice || product.price || 0 %>">K<%= (product.finalPrice || product.price || 0).toLocaleString() %></div>
                    <% } %>
                    <p class="tax-info">Tax included. Shipping calculated at checkout.</p>
                </div>

                <!-- COLOR VARIANTS -->
                <% if (normalizedColors.length > 0) { %>
                    <div class="variant-section variant-section--color">
                        <label class="variant-label" for="colorSelect">Color</label>
                        <div class="color-select-wrap">
                            <select id="colorSelect" class="color-select-input" name="color" autocomplete="off">
                                <option value="">Select a color</option>
                                <% normalizedColors.forEach((color) => { %>
                                    <option value="<%= color.name %>"><%= color.name %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <script type="application/json" id="product-color-images-data"><%- JSON.stringify(normalizedColors.map(function (c) { return { name: c.name, image: c.image }; })).replace(/</g, '\\u003c') %></script>
                <% } %>

                <!-- STRAP TYPE -->
                <% if (product.strapOptions && product.strapOptions.length > 0) { %>
                    <div class="variant-section">
                        <span class="variant-label">Strap Type:</span>
                        <div class="strap-options">
                            <% product.strapOptions.forEach((strap, index) => { %>
                                <button class="strap-option <%= index === 0 ? 'selected' : '' %>" 
                                        data-strap="<%= strap %>">
                                    <%= strap %>
                                </button>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <!-- QUANTITY SELECTOR -->
                <div class="quantity-section">
                    <label class="variant-label" for="quantityInput">Quantity:</label>
                    <div class="quantity-controls">
                        <button class="quantity-btn" id="decreaseQty" aria-label="Decrease quantity">
                            <i class="fas fa-minus"></i>
                        </button>
                        <input
                            type="number"
                            id="quantityInput"
                            class="quantity-input"
                            value="1"
                            min="1"
                            max="<%= typeof product.availableStock === 'number' ? product.availableStock : product.stock %>"
                            autocomplete="off"
                            readonly
                        >
                        <button class="quantity-btn" id="increaseQty" aria-label="Increase quantity">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>

                <!-- ACTION BUTTONS -->
                <div class="action-buttons">
                    <button class="btn-primary" id="addToCartBtn" data-product-id="<%= product.id || product._id %>" data-product-stock="<%= typeof product.availableStock === 'number' ? product.availableStock : product.stock %>" <%= (typeof product.availableStock === 'number' ? product.availableStock : product.stock) <= 0 ? 'disabled' : '' %>>
                        <i class="fas fa-shopping-cart"></i>
                        <%= (typeof product.availableStock === 'number' ? product.availableStock : product.stock) <= 0 ? 'Out of Stock' : 'Add to Cart' %>
                    </button>
                    <button class="btn-secondary" id="buyNowBtn" data-product-id="<%= product.id || product._id %>" <%= (typeof product.availableStock === 'number' ? product.availableStock : product.stock) <= 0 ? 'disabled' : '' %>>
                        <i class="fas fa-bolt"></i>
                        Buy Now
                    </button>
                </div>

                <!-- TRUST BADGES -->
                <div class="trust-badges">
                    <div class="trust-badge">
                        <i class="fas fa-shield-alt"></i>
                        <div>
                            <strong>Secure Payment</strong>
                            <span>SSL Encrypted</span>
                        </div>
                    </div>
                    <div class="trust-badge">
                        <i class="fas fa-truck"></i>
                        <div>
                            <strong>Free Shipping</strong>
                        </div>
                    </div>
                    <div class="trust-badge">
                        <i class="fas fa-undo"></i>
                        <div>
                            <strong>2-Month Warranty</strong>
                            <span>Defect & Damage Returns</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- PRODUCT DETAILS TABS -->
    <section class="tabs-section">
        <div class="tabs-container">
            <div class="tab-buttons">
                <button class="tab-btn active" data-tab="description">Description</button>
                <button class="tab-btn" data-tab="warranty">Warranty & Returns</button>
                <button class="tab-btn" data-tab="reviews">Reviews (<%= product.reviews && product.reviews.length ? product.reviews.length : 0 %>)</button>
            </div>

            <div class="tab-content-container">
                <!-- Description Tab -->
                <div class="tab-content active" id="description">
                    <h3>Product Description</h3>
                    <p><%= product.description %></p>
                </div>

                <!-- Warranty Tab -->
                <div class="tab-content" id="warranty">
                    <h3>Warranty</h3>
                    <p>
                        All Qualitick Collections watches come with a <strong>2-month warranty</strong> against manufacturer defects. This warranty does not cover misuse, accidents, or natural wear and tear.
                    </p>

                    <h3>Returns and Refunds</h3>
                    <p>
                        Returns are accepted only if the watch is defective or damaged on delivery. Issues must be reported within <strong>48 hours</strong> if delivery issue or warranty period. Customers are responsible for return shipping costs unless otherwise agreed. Refunds are processed within <strong>15-20 business days</strong> after inspection.
                    </p>
                </div>

                <!-- Reviews Tab -->
                <div class="tab-content" id="reviews">
                    <div class="reviews-summary">
                        <div class="reviews-rating">
                            <div class="overall-rating">
                                <span class="rating-number"><%= product.rating %></span>
                                <div class="stars-large">
                                    <%- include('partials/star-rating', { rating: product.rating }) %>
                                </div>
                                <p>Based on <%= product.reviews && product.reviews.length ? product.reviews.length : 0 %> reviews</p>
                            </div>
                        </div>

                        <button class="btn-outline" id="writeReviewBtn">Write a Review</button>
                    </div>

                    <div class="reviews-list">
                        <% if (product.reviews && product.reviews.length > 0) { %>
                            <% product.reviews.forEach(review => { %>
                                <% 
                                    // Handle both old and new review formats
                                    const reviewName = review.name || review.user || 'Anonymous';
                                    const reviewTitle = review.title || '';
                                    const reviewComment = review.comment || '';
                                    const reviewRating = review.rating || 0;
                                    const reviewDate = review.createdAt || review.date || new Date();
                                    const isVerified = review.verified === true;
                                %>
                                <div class="review-card">
                                    <div class="review-header">
                                        <div class="reviewer-info">
                                            <div class="reviewer-avatar"><%= reviewName.charAt(0).toUpperCase() %></div>
                                            <div>
                                                <h4><%= reviewName %></h4>
                                                <p class="review-date"><%= new Date(reviewDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                                            </div>
                                        </div>
                                        <div class="review-rating">
                                            <% for(let i = 1; i <= 5; i++) { %>
                                                <i class="fas fa-star <%= i <= reviewRating ? 'filled' : '' %>"></i>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="review-content">
                                        <% if (reviewTitle) { %>
                                            <h5><%= reviewTitle %></h5>
                                        <% } %>
                                        <p><%= reviewComment %></p>
                                    </div>
                                    <% if (isVerified) { %>
                                        <div class="verified-badge">
                                            <i class="fas fa-check-circle"></i> Verified Purchase
                                        </div>
                                    <% } %>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="no-reviews">
                                <i class="far fa-comments"></i>
                                <p>No reviews yet. Be the first to review this product!</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- RELATED PRODUCTS -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
        <section class="related-products-section">
            <h2 class="section-title">You May Also Like</h2>
            <div class="related-products-grid">
                <% relatedProducts.forEach(related => { %>
                    <a href="/product/<%= related._id %>" class="related-product-card">
                        <div class="related-product-image">
                            <img src="<%= related.images[0] || '/images/placeholder.jpg' %>" alt="<%= related.model %>">
                            <% if (related.discount > 0) { %>
                                <div class="discount-badge-small">-<%= related.discount %>%</div>
                            <% } %>
                        </div>
                        <div class="related-product-info">
                            <p class="related-brand"><%= related.brand %></p>
                            <h4><%= related.model %></h4>
                            <div class="related-rating">
                                <% for(let i = 1; i <= 5; i++) { %>
                                    <i class="fas fa-star <%= i <= Math.floor(related.rating) ? '' : 'empty' %>"></i>
                                <% } %>
                                <span>(<%= related.rating %>)</span>
                            </div>
                            <div class="related-price">
                                <% if (related.discount > 0 && related.originalPrice > related.finalPrice) { %>
                                    <span class="related-original">K<%= related.originalPrice.toLocaleString() %></span>
                                    <span class="related-current">K<%= related.finalPrice.toLocaleString() %></span>
                                <% } else { %>
                                    <span class="related-current">K<%= related.finalPrice.toLocaleString() %></span>
                                <% } %>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        </section>
    <% } %>

    <!-- Image Zoom Modal -->
    <div class="zoom-modal" id="zoomModal">
        <button class="zoom-close" id="zoomClose">&times;</button>
        <img id="zoomedImage" src="" alt="Zoomed product image">
    </div>

    <!-- Review Modal -->
    <div class="review-modal" id="reviewModal">
        <div class="review-modal-content">
            <button class="review-close" id="reviewClose">&times;</button>
            <h3>Write a Review</h3>
            <% if (currentUser) { %>
            <div class="review-info-message" style="background: #e8f5e9; padding: 12px; border-radius: 6px; margin-bottom: 20px; font-size: 14px; color: #2e7d32;">
                <i class="fas fa-check-circle"></i>
                Reviewing as <strong><%= currentUser.name %></strong> (<%= currentUser.email %>)
            </div>
            <% } else { %>
            <div class="review-info-message" style="background: #e3f2fd; padding: 12px; border-radius: 6px; margin-bottom: 20px; font-size: 14px; color: #1976d2;">
                <i class="fas fa-info-circle"></i>
                Only verified buyers can review. Please use the same email used during checkout.
            </div>
            <% } %>
            <form id="reviewForm">
                <div class="form-group">
                    <label>Your Rating *</label>
                    <div class="star-rating-input">
                        <i class="far fa-star" data-rating="1"></i>
                        <i class="far fa-star" data-rating="2"></i>
                        <i class="far fa-star" data-rating="3"></i>
                        <i class="far fa-star" data-rating="4"></i>
                        <i class="far fa-star" data-rating="5"></i>
                    </div>
                    <input type="hidden" name="rating" id="reviewRating" autocomplete="off" required>
                </div>
                <div class="form-group">
                    <label for="reviewTitle">Review Title *</label>
                    <input type="text" id="reviewTitle" name="title" autocomplete="off" required placeholder="Sum up your experience" maxlength="100">
                </div>
                <div class="form-group">
                    <label for="reviewComment">Your Review *</label>
                    <textarea id="reviewComment" name="comment" rows="5" autocomplete="off" required placeholder="Share your thoughts about this product" maxlength="1000"></textarea>
                </div>
                <div class="form-group">
                    <label for="reviewName">Your Name *</label>
                    <input type="text" id="reviewName" name="name" autocomplete="name" required maxlength="100"<% if (currentUser) { %> value="<%= currentUser.name %>"<% } %>>
                </div>
                <% if (!currentUser) { %>
                <div class="form-group">
                    <label for="reviewEmail">Your Email *</label>
                    <input type="email" id="reviewEmail" name="email" autocomplete="email" required placeholder="Use the email from your order">
                    <small style="color: #666; font-size: 12px;">We'll verify your purchase using this email</small>
                </div>
                <% } %>
                <button type="submit" class="btn-primary">Submit Review</button>
            </form>
        </div>
    </div>

    <!-- Pass product and user data to JavaScript -->
    <script>
        window.productData = <%- JSON.stringify(product).replace(/</g, '\\u003c') %>;
        window.currentUser = <%- JSON.stringify(currentUser || null).replace(/</g, '\\u003c') %>;
    </script>

    <script type="application/ld+json"><%- JSON.stringify(productLd).replace(/</g, '\\u003c') %></script>
    <script type="application/ld+json"><%- JSON.stringify(breadcrumbLd).replace(/</g, '\\u003c') %></script>

    <script src="/js/productdetails.js"></script>
<%- include('partials/footer') %>
