# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
# (cPanel will auto-inject Passenger config here when the Node.js app is set up)
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# Disable directory listing
Options -Indexes

# Block access to sensitive files
<FilesMatch "(^\.env|^\.env\..+|package\.json|package-lock\.json|server\.js|CLAUDE\.md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to source and config directories
    RewriteRule ^(src|node_modules|scripts|example-dpo|views|controllers|docs|materials)(/|$) - [F,L]
</IfModule>

# Show maintenance page when Node.js/Passenger is down or on server errors
ErrorDocument 500 /maintenance.html
ErrorDocument 502 /maintenance.html
ErrorDocument 503 /maintenance.html
ErrorDocument 504 /maintenance.html
